---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import Section from '../components/layout/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import LineButton from '../components/ui/LineButton.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import Positioning from '../components/sections/Positioning.astro';
import CaseList from '../components/sections/CaseList.astro';

// 価格方針(brief §6b): プログラム料金は掲載しない。「料金はお問い合わせください」で統一
const faqs = [
  {
    q: '料金はいくらですか。',
    a: '内容・期間により異なるため、個別相談・お問い合わせにてご案内しています。',
  },
  {
    q: 'まだ悩みがまとまっていません。相談してもよいですか。',
    a: 'まとまっていない相談ほど、歓迎です。整理するところから一緒に始めましょう。',
  },
  {
    q: '会社を通さず、個人で申し込めますか。',
    a: 'はい。個人のままお申し込みいただけます(企業のチーム研修も承っています)。',
  },
  {
    q: '業務の代行はしてもらえますか。',
    a: '代行はしません。ご自身が再現できる手法を残すことがゴールです。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const flow = [
  {
    title: 'ご連絡',
    body: '個人の方はLINEで「個別相談」と送信、法人の方はお問い合わせからご連絡ください。',
  },
  { title: '予約・日程調整', body: '予約フォームをお送りします。ご都合のよい枠をお選びください。' },
  { title: '個別相談・ヒアリング', body: 'オンラインで現状を伺い、「どこから手を付けるか」を一緒に見立てます。' },
  {
    title: 'ご提案・お見積り',
    body: '内容を伺ったうえで、プログラムと金額を個別にご案内します。',
  },
  { title: 'ご契約・開始', body: '内容にご納得いただけたら、伴走を開始します。' },
];

const bootcampGains = [
  '戦略的思考・仮説構築力',
  '構造化・論理展開力',
  'ファシリテーション・ヒアリング力',
  '課題設定と実行のPDCA',
];
---

<Base
  title="サービス"
  description="個人向けの社外参謀1on1ブートキャンプ・伴走プログラムと、法人向けのチーム研修・プロジェクト伴走支援。教育×実践×リフレクションの循環で「思考OS」を構築します。"
  jsonLd={[faqLd]}
>
  <Breadcrumb items={[{ label: 'サービス' }]} />

  <div class="mx-auto max-w-[1120px] px-5 pt-10 pb-16 md:pt-16 md:pb-24 lg:px-10">
    <h1 class="text-[28px] font-bold md:text-4xl">サービス</h1>
    <p class="mt-6 max-w-[34em] text-lg font-bold text-balance text-primary-700">
      新任リーダー・プレイングマネージャーが、ひとりで抱え込むプレイヤーから、チームで成果を出す推進者へ。
    </p>
    <p class="mt-4 max-w-[38em] text-muted">
      再現性の高い「思考OS」と、その土台となるポータブルスキルを、教育×実践×リフレクションの循環で身につける伴走プログラムです。
    </p>
  </div>

  <Section tone="subtle">
    <SectionTitle>なぜ、学びは現場で止まるのか</SectionTitle>
    <div class="grid gap-4 md:grid-cols-3 md:gap-6" data-reveal="group">
      {[
        '研修を受けても、現場で行動が変わらない',
        '日々の忙しさで、振り返りが続かない',
        '上司も忙しく、フォローしきれない',
      ].map((stall) => (
        <p class="rounded-lg border border-edge bg-white p-5 font-bold text-balance text-primary-700">
          {stall}
        </p>
      ))}
    </div>
    <p class="mt-6 max-w-[42em]" data-reveal>
      だから私たちは、講義で終わらせません。<strong>「どこから手を付けるか」の見立て</strong>と、<strong>実行が続く仕組み(定期セッション・チャットでの壁打ち・振り返り)</strong>をセットにして、成果が出るまで隣を走ります。
    </p>
  </Section>

  <Section>
    <SectionTitle>支援の流れ</SectionTitle>
    <p class="mb-8 max-w-[42em] text-muted" data-reveal>
      どのプログラムも、この流れで進みます。入口は無料の30秒診断からで大丈夫です。
    </p>
    <ol class="grid gap-3 md:grid-cols-3 lg:grid-cols-6" data-reveal="group">
      {[
        ['現状を知る', '30秒診断(無料)と個別相談で、ボトルネックを見立てる'],
        ['目標を決める', 'テーマを設定し、目指す状態を言語化する'],
        ['学ぶ', '思考の型とポータブルスキルを身につける'],
        ['現場で実践', '自分の現場で行動し、変化を起こす'],
        ['振り返る', '定期セッションとチャットで実践結果を言語化する'],
        ['自走する', 'やり方が手元に残り、伴走は卒業',],
      ].map(([title, body], i, arr) => (
        <li class="relative rounded-lg border border-edge bg-white p-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary-700 text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-3 text-sm font-semibold text-primary-700">{title}</h3>
          <p class="mt-1 text-xs leading-relaxed text-muted">{body}</p>
          {i < arr.length - 1 && (
            <span class="absolute top-1/2 -right-[15px] hidden -translate-y-1/2 text-sm font-bold text-brand-teal lg:block" aria-hidden="true">→</span>
          )}
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm" data-reveal>
      <a href="/shindan/" class="font-bold text-primary-700 underline underline-offset-4">
        まずは30秒診断で、現状を確かめる(無料・登録不要) →
      </a>
    </p>
  </Section>

  <Section tone="subtle">
    <SectionTitle>共通の考え方</SectionTitle>
    <div class="grid gap-4 md:grid-cols-3 md:gap-6">
      <div class="rounded-lg border border-edge bg-white p-6">
        <h3 class="mb-2 font-semibold text-primary-700">課題のとらえ方</h3>
        <p class="text-sm text-muted">
          「あと一歩の壁」(仕事・キャリア・人生)を越えられない真の原因は、多くの場合、専門知識ではなく<a href="/portable-skills/" class="font-bold text-primary-700 underline underline-offset-4">ポータブルスキル</a>の欠如にあります。
        </p>
      </div>
      <div class="rounded-lg border border-edge bg-white p-6">
        <h3 class="mb-2 font-semibold text-primary-700">解決のアプローチ</h3>
        <p class="text-sm text-muted">
          ボトルネックを特定し、発言や行動のベースとなる考え方・価値観、つまり再現性の高い「思考OS」をインストールします。
        </p>
      </div>
      <div class="rounded-lg border border-edge bg-white p-6">
        <h3 class="mb-2 font-semibold text-primary-700">進め方</h3>
        <p class="text-sm text-muted">
          教育×実践×リフレクションの循環。先生の顔をしない対話型で、行動を重視し、自走できる状態をゴールにします。
        </p>
      </div>
    </div>
  </Section>

  <Section>
    <SectionTitle id="personal">個人向けプログラム</SectionTitle>

    <div class="space-y-6">
      <article class="rounded-lg border border-edge bg-white p-6 md:p-8">
        <p class="mb-2 text-xs font-bold text-primary-500">STEP 0|入口</p>
        <h3 class="mb-3 text-xl font-semibold text-primary-700">個別相談</h3>
        <p class="mb-4 max-w-[42em] text-sm text-muted">
          60分・3,000円・オンライン。あなたの現場の「どこから手を付けるか」の見立てを、その場で必ずお渡しします。相談だけで終えていただいて構いません。LINEで「個別相談」と送るだけで始められます。
        </p>
        <LineButton class="max-w-md" />
      </article>

      <article class="rounded-lg border border-edge bg-white p-6 md:p-8">
        <p class="mb-2 text-xs font-bold text-primary-500">STEP 1|全4回・マンツーマン</p>
        <h3 class="mb-3 text-xl font-semibold text-primary-700">社外参謀 1on1ブートキャンプ</h3>
        <p class="mb-4 max-w-[42em] text-sm text-muted">
          あなたの仕事とキャリアに"社外の専属参謀"が1人つく、全4回・マンツーマンの超実務プログラムです。実績豊富で利害関係のない社外の参謀と、案件ベースで思考を鍛えます。
        </p>
        <dl class="mb-4 grid grid-cols-2 gap-x-4 gap-y-2 rounded-md bg-paper-subtle p-4 text-sm md:grid-cols-3">
          <div><dt class="text-xs font-bold text-muted">回数</dt><dd class="font-bold">全4回</dd></div>
          <div><dt class="text-xs font-bold text-muted">形式</dt><dd class="font-bold">マンツーマン</dd></div>
          <div class="col-span-2 md:col-span-1"><dt class="text-xs font-bold text-muted">成果物</dt><dd class="font-bold">90日アクションプラン</dd></div>
        </dl>
        <div class="mb-4 rounded-md bg-paper-subtle p-4 text-sm">
          <p class="mb-1 font-bold">プログラムの流れ</p>
          <ol class="list-decimal space-y-1 pl-5 text-muted">
            <li>テーマ設定</li>
            <li>ボトルネックの特定</li>
            <li>打ち手の検討</li>
            <li>アクションプランの明確化(90日)</li>
          </ol>
        </div>
        <div class="mb-4 rounded-md border border-primary-100 bg-primary-100/40 p-4">
          <p class="mb-2 text-sm font-bold">終了時に目指す状態(業務の言葉で)</p>
          <ul class="space-y-1.5 text-sm text-muted">
            {[
              'チームのボトルネックを、印象ではなく構造で説明できる',
              'AS-IS/TO-BEと90日のアクションプランを、自分の言葉で語れる',
              '問いで相手の考えを引き出し、会議やヒアリングを前に進められる',
              '打ち手を決めて実行し、振り返るサイクルを自分で回せる',
            ].map((goal) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-orange" aria-hidden="true"></span>
                {goal}
              </li>
            ))}
          </ul>
        </div>
        <div class="mb-4">
          <p class="mb-2 text-sm font-bold">獲得できるもの</p>
          <ul class="flex flex-wrap gap-2">
            {bootcampGains.map((gain) => (
              <li class="rounded-sm bg-primary-100 px-3 py-1 text-xs font-bold text-primary-700">
                {gain}
              </li>
            ))}
          </ul>
        </div>
        <p class="mb-1 text-sm text-muted">
          対象: 経営企画・事業推進・DX推進・人事企画など、問題解決を仕事にしている方。コンサルティング業界を志望する方。
        </p>
        {/* TODO: 活用例2件(超実務1on1プログラム資料p.13)の要約掲載は原文入手後に追加 */}
        <p class="mt-4 border-t border-edge pt-4 text-sm font-bold">
          料金: お問い合わせください
          <a href="/contact/" class="ml-3 font-bold text-primary-500 underline underline-offset-4">
            料金を問い合わせる
          </a>
        </p>
      </article>

      <article class="rounded-lg border border-edge bg-white p-6 md:p-8">
        <p class="mb-2 text-xs font-bold text-primary-500">STEP 2|月2回・3〜6か月</p>
        <h3 class="mb-3 text-xl font-semibold text-primary-700">社外参謀 伴走プログラム</h3>
        <p class="mb-4 max-w-[42em] text-sm text-muted">
          ブートキャンプで構築した「思考OS」を現場実装し、目に見える成果を取りに行く長期プロジェクトです。学んで終わりにしないための、見立てと「実行が続く仕組み」がセットになっています。
        </p>
        <dl class="mb-4 grid grid-cols-2 gap-x-4 gap-y-2 rounded-md bg-paper-subtle p-4 text-sm md:grid-cols-3">
          <div><dt class="text-xs font-bold text-muted">セッション</dt><dd class="font-bold">月2回・60分程度</dd></div>
          <div><dt class="text-xs font-bold text-muted">期間</dt><dd class="font-bold">標準3か月/ロング6か月</dd></div>
          <div class="col-span-2 md:col-span-1"><dt class="text-xs font-bold text-muted">期間中サポート</dt><dd class="font-bold">チャット相談(平日24〜48時間以内に返信)</dd></div>
        </dl>
        <ul class="mb-4 space-y-2 text-sm text-muted">
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-orange" aria-hidden="true"></span>
            期間中はチャットで相談・壁打ちが可能です(原則、平日24〜48時間以内に返信)。
          </li>
          <li class="flex gap-2">
            <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-orange" aria-hidden="true"></span>
            重要会議・提案・評価面談・転職面接など「勝負どころ」の前後で、壁打ち・シミュレーションを行います。
          </li>
        </ul>
        <p class="mb-1 text-sm text-muted">
          対象: ブートキャンプを終え、「この社外参謀と半年〜1年、本気で走ってみたい」と感じた方。
        </p>
        <p class="mt-4 border-t border-edge pt-4 text-sm font-bold">
          料金: お問い合わせください
          <a href="/contact/" class="ml-3 font-bold text-primary-500 underline underline-offset-4">
            料金を問い合わせる
          </a>
        </p>
      </article>
    </div>
  </Section>

  <Section tone="subtle">
    <SectionTitle id="corporate">法人向けプログラム</SectionTitle>

    <div class="space-y-6">
      <article class="rounded-lg border border-edge bg-white p-6 md:p-8">
        <h3 class="mb-3 text-xl font-semibold text-primary-700">チーム研修(基本パッケージ)</h3>
        <p class="mb-4 max-w-[42em] text-sm text-muted">
          教育×実践×リフレクションによる、再現可能で持続的な成長のための包括支援です。貴社の状況に合わせてカスタマイズできます。
        </p>
        <ol class="mb-4 space-y-3">
          {[
            ['00 キックオフ(必須)', '心理的安全性の確保と、ポータブルスキル・取り組みの狙いの説明'],
            ['01 ポータブルスキルワークショップ', '1〜2週間ごと・全4回。現状分析、目標設定、戦略思考、問題解決、コミュニケーション、ファシリテーションなど'],
            ['02 プロジェクト計画書の作成支援', '学びを行動計画書(プロジェクト計画書)に落とし込みます'],
            ['03 フォローアップ / プロジェクト遂行支援', '週1回または隔週で、実行を徹底的に支援します'],
          ].map(([title, body]) => (
            <li class="rounded-md bg-paper-subtle p-4 text-sm">
              <p class="font-bold text-primary-700">{title}</p>
              <p class="mt-1 text-muted">{body}</p>
            </li>
          ))}
        </ol>
        <p class="mb-4 text-sm text-muted">
          特徴: 3名程度の少人数・高密度。自走化を前提に、段階的に支援を減らすフェーズアウト設計です。
        </p>
        <div class="mb-1 rounded-md border border-primary-100 bg-primary-100/40 p-4">
          <p class="mb-2 text-sm font-bold">目指す変化(業務の言葉で)</p>
          <ul class="space-y-1.5 text-sm text-muted">
            {[
              'メンバーが自分たちで現状を分析し、プロジェクト計画書を作って実行できる',
              '支援を段階的に減らしても、取り組みが止まらない',
            ].map((goal) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-orange" aria-hidden="true"></span>
                {goal}
              </li>
            ))}
          </ul>
        </div>
        <p class="mt-4 border-t border-edge pt-4 text-sm font-bold">
          料金: お問い合わせください
          <a href="/contact/" class="ml-3 font-bold text-primary-500 underline underline-offset-4">
            料金を問い合わせる
          </a>
        </p>
      </article>

      <article class="rounded-lg border border-edge bg-white p-6 md:p-8">
        <h3 class="mb-3 text-xl font-semibold text-primary-700">プロジェクト伴走支援・コンサルティング</h3>
        <p class="mb-4 max-w-[42em] text-sm text-muted">
          「はい、わかりました」とは言いません。代行ではなく共創で、ノウハウが社内に残り、自走できる状態をゴールにします。
        </p>
        <p class="mt-4 border-t border-edge pt-4 text-sm font-bold">
          料金: お問い合わせください
          <a href="/contact/" class="ml-3 font-bold text-primary-500 underline underline-offset-4">
            料金を問い合わせる
          </a>
        </p>
      </article>
    </div>

    <div class="mt-12">
      <h3 class="mb-4 text-sm font-bold tracking-wide text-muted">支援実績</h3>
      <CaseList />
    </div>
  </Section>

  <Section>
    <SectionTitle>研修でも、コンサルでもなく</SectionTitle>
    <Positioning />
  </Section>

  <Section tone="subtle" narrow>
    <SectionTitle>ご相談の流れ</SectionTitle>
    <ol class="space-y-4">
      {flow.map((step, i) => (
        <li class="flex gap-4 rounded-lg border border-edge bg-white p-5">
          <span
            class="flex h-9 w-9 flex-none items-center justify-center rounded-md bg-primary-700 text-sm font-bold text-white"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div>
            <h3 class="font-semibold text-primary-700">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section narrow>
    <SectionTitle>よくあるご質問</SectionTitle>
    <dl class="space-y-4">
      {faqs.map((faq) => (
        <div class="rounded-lg border border-edge bg-white p-6">
          <dt class="font-bold text-primary-700">Q. {faq.q}</dt>
          <dd class="mt-2 text-sm text-muted">A. {faq.a}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <CtaSection />
</Base>
