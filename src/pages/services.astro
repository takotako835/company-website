---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import Section from '../components/layout/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import LineButton from '../components/ui/LineButton.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import Positioning from '../components/sections/Positioning.astro';
import CaseList from '../components/sections/CaseList.astro';
import PricingPolicy from '../components/sections/PricingPolicy.astro';

// 価格方針(brief §6b): プログラム料金は掲載しない。「料金はお問い合わせください」で統一
const faqs = [
  {
    q: '料金はいくらですか。',
    a: '内容・期間により異なるため、個別相談・お問い合わせにてご案内しています。',
  },
  {
    q: 'まだ悩みがまとまっていません。相談してもよいですか。',
    a: 'まとまっていない相談ほど、歓迎です。整理するところから一緒に始めましょう。',
  },
  {
    q: '会社を通さず、個人で申し込めますか。',
    a: 'はい。個人のままお申し込みいただけます(企業のチーム研修も承っています)。',
  },
  {
    q: '業務の代行はしてもらえますか。',
    a: '代行はしません。ご自身が再現できる手法を残すことがゴールです。',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const flow = [
  {
    title: 'ご連絡',
    body: '個人の方はLINEで「個別相談」と送信、法人の方はお問い合わせからご連絡ください。',
  },
  { title: '予約・日程調整', body: '予約フォームをお送りします。ご都合のよい枠をお選びください。' },
  { title: '個別相談・ヒアリング', body: 'オンラインで現状を伺い、「どこから手を付けるか」を一緒に見立てます。' },
  {
    title: 'ご提案・お見積り',
    body: '内容を伺ったうえで、プログラムと金額を個別にご案内します。',
  },
  { title: 'ご契約・開始', body: '内容にご納得いただけたら、伴走を開始します。' },
];

// 身につけたものが届く範囲(トップページ 02 と同じ軸の短縮版)。
// 到達点は「目指す状態」として示す(成果実績としては書かない)
const BAR_WIDTHS = ['w-1/3', 'w-2/3', 'w-full'];

const reach = [
  { scope: '目の前の仕事で', body: '会議の論点が定まり、提案が前に進みます。' },
  { scope: 'チームと組織で', body: '任せられる範囲が広がり、まわりが育ちます。' },
  { scope: 'キャリアと人生で', body: '次の一手を、自分の言葉で選べるようになります。' },
];

const bootcampGains = [
  '戦略的思考・仮説構築力',
  '構造化・論理展開力',
  'ファシリテーション・ヒアリング力',
  '課題設定と実行のPDCA',
];

// 獲得できるマインドセット(超実務1on1プログラム資料 p.15 より)
const bootcampMindsets = [
  '試行錯誤と検証を楽しめるマインド',
  '「どう生きたいか」から逆算してキャリアを選ぶ視点',
];

// ブートキャンプ各回の進め方(同資料 p.12 より)
const bootcampSteps = [
  ['テーマ設定', '現在地を整理し、向き合うテーマを決めます。'],
  ['ボトルネックの特定', '論点や課題を整理し、どこで詰まっているのかを特定します。'],
  ['打ち手の検討', '解決策をつくり込みます。ロールプレイ・演習も行います。'],
  ['アクションプランの明確化', '次のステージへ進むための、90日間の計画を作り切ります。'],
];

// ブートキャンプの特徴(同資料 p.14 より。見出し+1行に圧縮)
const bootcampFeatures = [
  {
    title: '「思考OS」をインストールできる',
    body: 'メソッドをご自身の案件に当てはめて使うから、「知っている」が「使える」になります。',
  },
  {
    title: '"社外参謀"スタイルのマンツーマン形式',
    body: '「何を変えれば前へ進めるのか」を、伴走しながら一緒に作り込みます。',
  },
  {
    title: '案件ベースの実践的なフィードバック',
    body: '実案件をテーマに、アウトプットの磨き込みまでセッション中に行います。',
  },
  {
    title: 'スキル・マインドセットの両方を体系化',
    body: '転職・副業・独立など、人生の意思決定の場面でも使いまわせる形にします。',
  },
];

// 活用例(同資料 p.13 の事例を、比較しやすい項目形式で要約)
const bootcampCases = [
  {
    person: '大手事業会社・30代・経営企画',
    problem: '評価は悪くないのに、「もう一段上」を求められる',
    rows: [
      ['状況', '評価は平均より少し上。しかし上司からは「もっと上流から、経営目線で提案して」と言われ続けていた'],
      ['テーマ', '今の中期計画プロジェクトで、経営会議に出せるレベルの素案を作る'],
      ['行ったこと', '経営が本当に気にしている論点の整理と、上司との1on1で論点をぶつけるトークスクリプトづくり'],
    ],
    changes: [
      '社内でのポジションが「作業が早い人」から「経営の相談相手」になってきた',
      '強み・弱みと、今後3年のキャリアの方向性がクリアになった',
    ],
  },
  {
    person: 'SIer・30代・ITコンサルタント',
    problem: 'プロジェクトを任されたものの、自信が持てない',
    rows: [
      ['状況', '中規模プロジェクトのリードを初めて任されたが、毎週の定例会議は論点が散らばり、いつも時間切れ'],
      ['テーマ', 'このプロジェクトを、半年以内に安定軌道に乗せる'],
      ['行ったこと', '詰まっている場所の特定、定例会議の進行台本づくりとロールプレイ、90日ロードマップの設計'],
    ],
    changes: [
      '会議が「何となく報告する場」から「決める場」に変わった',
      'クライアントから「次の案件もぜひお願いしたい」と言われるようになった',
    ],
  },
];

// 伴走プログラムで目指す状態(同資料 p.19 より)
const partnerGoals = [
  {
    wall: '仕事',
    body: '主要案件で「自分の成果」と言える実績が挙がり、上司・クライアントからの信頼・期待値が一段上がる',
  },
  {
    wall: 'キャリア',
    body: '次の一手(昇格・転職・社内異動・独立など)について、具体的な行動とスケジュールが動き出している',
  },
  {
    wall: '人生',
    body: '大事にしたい価値観が明確になり、ワークライフバランスや投資すべき領域が整理されている',
  },
];

// 思考OSインストール前後の変化(同資料 p.8 より)
const osBefore = [
  '頑張っているのに、満足度が低い',
  '向かう先が見えない',
  '「このまま今の会社でいいのか」と悩み続ける',
  '転職・副業・独立を決断できない',
];
const osAfter = [
  '何のために働くのかを、自分の言葉にできる',
  '次の3年の軸が定まる',
  '優先順位が明確になり、意思決定がぶれない',
  '人生の満足度が上がる',
];

// ほかの研修・コーチングと違う理由(同資料 p.4 より)
const differences = [
  {
    title: '「理屈」だけでなく「実装」を知っている',
    body: 'シンプルだから実装できる、実装できるから使い続けられる。現場で使い切れる形のフレームワークにこだわります。',
  },
  {
    title: '「キャリア」と「人生」を統合的に見ている',
    body: '今の案件で成果を出すこと、キャリアを戦略的に描くこと、人生の満足度を高めること。この3つを同時に追いかけます。',
  },
  {
    title: '「内部からは見えない盲点」を指摘できる',
    body: '利害関係のない外部者だからこそ、社内では言いにくいこと、内側からは気づけない本当のボトルネックを浮き彫りにできます。',
  },
  {
    title: '「商店街で学んだ温かさ」を忘れていない',
    body: '突き放さず、評論家にもならず。一緒に考え、一緒に悩み、一緒に進みます。',
  },
];

// 相性を正直に示す。理念(行動重視・自走支援・時間の確保)と既存FAQから導いた内容のみ
const goodFit = [
  {
    title: '小さくても、行動を起こす方',
    body: '「1万回分析しても、行動しなければ成果はゼロ」と考えています。完璧でなくて構いません。実際に動いてくださる方と、いちばん良い成果が出ています。',
  },
  {
    title: '「できるようになる」ことを望む方',
    body: '成果物を受け取ることよりも、自分やチームに再現できる力が残ることに価値を感じる方に向いています。',
  },
  {
    title: '成長のための時間を守れる方',
    body: '週に一度でも構いません。学びと振り返りの時間を確保する意思のある方と、ご一緒しています。',
  },
  {
    title: 'まだ、整理がついていない方',
    body: 'まとまっていない相談ほど歓迎です。何が問題なのかを言葉にするところから、一緒に始めます。',
  },
];

const notFit = [
  {
    title: '業務の代行',
    body: '資料作成やプロジェクトの運営を、代わりに引き受けることはしません。ご自身が再現できる形でお渡しすることが、私たちの役割だと考えているためです。',
  },
  {
    title: '答えだけをお渡しすること',
    body: '先生の顔をせず、同じ側から一緒に考える進め方をとっています。結論だけを急いで受け取りたい場合は、ご期待に沿えないかもしれません。',
  },
  {
    title: '時間をまったく確保できない状況での実施',
    body: '成長には、まとまった時間が必要です。今は難しいという場合は、状況が整うタイミングまでお待ちすることもあります。',
  },
];

// 支援の3原則(会社説明資料 p.20 より)
const supportPrinciples = [
  {
    title: '「釣りを教える」アプローチ',
    body: '業務の代行ではなく、ご自身が再現できるスキルと手法を身につけるサポートをします。答えを教えるのではなく、自ら考え、行動する力を引き出すことを重視します。',
  },
  {
    title: '成長のための時間を確保する',
    body: 'ポータブルスキルの開発には、まとまった時間を確保していただきます。たとえば毎週金曜日を「勉強会の日」と決め、その時間は参加者の成長に集中します。',
  },
  {
    title: '「教育×実践×リフレクション」の循環',
    body: '知識の提供だけで終わらせず、実践と振り返りのサイクルを回します。定期的なフォローアップで、継続的な成長を支えます。',
  },
];
---

<Base
  title="サービス"
  description="個人向けの社外参謀1on1ブートキャンプ・伴走プログラムと、法人向けのチーム研修・プロジェクト伴走支援。教育×実践×リフレクションの循環で「思考OS」を構築します。"
  jsonLd={[faqLd]}
>
  <Breadcrumb items={[{ label: 'サービス' }]} />

  <div class="mx-auto max-w-[1120px] px-5 pt-10 pb-16 md:pt-16 md:pb-24 lg:px-10">
    <h1 class="text-[28px] font-bold md:text-4xl">サービス</h1>
    <p class="mt-6 max-w-[34em] text-lg font-bold text-balance text-primary-700">
      新任リーダー・プレイングマネージャーが、ひとりで抱え込むプレイヤーから、チームで成果を出す推進者へ。
    </p>
    <p class="mt-4 max-w-[38em] text-muted">
      再現性の高い「思考OS」と、その土台となるポータブルスキルを、教育×実践×リフレクションの循環で身につける伴走プログラムです。
    </p>

    {/* トップページ 02「どこまでも、持ち運べる」と同じ軸を、冒頭に短く置く */}
    <div class="mt-12 border-t border-edge pt-10" data-reveal>
      <p class="mb-6 text-xs font-bold tracking-wide text-muted">身につけたものが、届く範囲</p>
      <ol class="grid gap-6 sm:grid-cols-3 sm:gap-8">
        {reach.map((item, i) => (
          <li>
            <span
              class:list={[
                'block h-1.5 rounded-full',
                BAR_WIDTHS[i],
                i === reach.length - 1 ? 'bg-brand-orange' : 'bg-brand-teal',
              ]}
              aria-hidden="true"
            ></span>
            <p class="mt-3 font-bold text-primary-700">{item.scope}</p>
            <p class="mt-1 text-sm text-muted">{item.body}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-[42em] text-sm text-muted">
        法人のご支援では、この変化がチームに広がり、やり方が社内に残ることを目指します。
      </p>
      <p class="mt-2 text-xs text-muted">
        ※いずれも、プログラムを通じて目指す状態です。到達までの期間や度合いは、状況によって異なります。
      </p>
    </div>
  </div>

  <Section tone="subtle">
    <SectionTitle>なぜ、学びは現場で止まるのか</SectionTitle>
    <div class="grid gap-4 md:grid-cols-3 md:gap-6" data-reveal="group">
      {[
        '研修を受けても、現場で行動が変わらない',
        '日々の忙しさで、振り返りが続かない',
        '上司も忙しく、フォローしきれない',
      ].map((stall) => (
        <p class="rounded-lg border border-edge bg-white p-5 font-bold text-balance text-primary-700">
          {stall}
        </p>
      ))}
    </div>
    <p class="mt-6 max-w-[42em]" data-reveal>
      だから私たちは、講義で終わらせません。<strong>「どこから手を付けるか」の見立て</strong>と、<strong>実行が続く仕組み(定期セッション・チャットでの壁打ち・振り返り)</strong>をセットにして、成果が出るまで隣を走ります。
    </p>
  </Section>

  <Section>
    <SectionTitle>支援の流れ</SectionTitle>
    <p class="mb-8 max-w-[42em] text-muted" data-reveal>
      どのプログラムも、この流れで進みます。入口は無料の30秒診断からで大丈夫です。
    </p>
    <ol class="grid gap-3 md:grid-cols-3 lg:grid-cols-6" data-reveal="group">
      {[
        ['現状を知る', '30秒診断(無料)と個別相談で、ボトルネックを見立てる'],
        ['目標を決める', 'テーマを設定し、目指す状態を言語化する'],
        ['学ぶ', '思考の型とポータブルスキルを身につける'],
        ['現場で実践', '自分の現場で行動し、変化を起こす'],
        ['振り返る', '定期セッションとチャットで実践結果を言語化する'],
        ['自走する', 'やり方が手元に残り、伴走は卒業',],
      ].map(([title, body], i, arr) => (
        <li class="relative rounded-lg border border-edge bg-white p-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary-700 text-sm font-bold text-white" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-3 text-sm font-semibold text-primary-700">{title}</h3>
          <p class="mt-1 text-xs leading-relaxed text-muted">{body}</p>
          {i < arr.length - 1 && (
            <span class="absolute top-1/2 -right-[15px] hidden -translate-y-1/2 text-sm font-bold text-brand-teal lg:block" aria-hidden="true">→</span>
          )}
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm" data-reveal>
      <a href="/shindan/" class="font-bold text-primary-700 underline underline-offset-4">
        まずは30秒診断で、現状を確かめる(無料・登録不要) →
      </a>
    </p>
  </Section>

  <Section tone="subtle">
    <SectionTitle>共通の考え方</SectionTitle>
    <div class="grid gap-4 md:grid-cols-3 md:gap-6">
      <div class="rounded-lg border border-edge bg-white p-6">
        <h3 class="mb-2 font-semibold text-primary-700">課題のとらえ方</h3>
        <p class="text-sm text-muted">
          「あと一歩の壁」(仕事・キャリア・人生)を越えられない真の原因は、多くの場合、専門知識ではなく<a href="/portable-skills/" class="font-bold text-primary-700 underline underline-offset-4">ポータブルスキル</a>の欠如にあります。
        </p>
      </div>
      <div class="rounded-lg border border-edge bg-white p-6">
        <h3 class="mb-2 font-semibold text-primary-700">解決のアプローチ</h3>
        <p class="text-sm text-muted">
          ボトルネックを特定し、発言や行動のベースとなる考え方・価値観、つまり再現性の高い「思考OS」をインストールします。
        </p>
      </div>
      <div class="rounded-lg border border-edge bg-white p-6">
        <h3 class="mb-2 font-semibold text-primary-700">進め方</h3>
        <p class="text-sm text-muted">
          教育×実践×リフレクションの循環。先生の顔をしない対話型で、行動を重視し、自走できる状態をゴールにします。
        </p>
      </div>
    </div>

    <div class="mt-8 rounded-lg border border-edge bg-white p-6 md:p-8" data-reveal>
      <h3 class="mb-4 font-semibold text-primary-700">「思考OS」が変えるもの</h3>
      <div class="grid gap-6 md:grid-cols-[1fr_auto_1fr] md:items-center">
        <div>
          <p class="mb-2 text-xs font-bold tracking-wide text-muted">インストール前</p>
          <ul class="space-y-1.5 text-sm text-muted">
            {osBefore.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-edge" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <p class="rotate-90 text-center text-xl font-bold text-brand-teal md:rotate-0" aria-hidden="true">→</p>
        <div>
          <p class="mb-2 text-xs font-bold tracking-wide text-primary-500">インストール後</p>
          <ul class="space-y-1.5 text-sm">
            {osAfter.map((item) => (
              <li class="flex gap-2 font-bold text-primary-700">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand-orange" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 overflow-hidden rounded-lg border border-edge bg-white" data-reveal>
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-bold text-primary-700 transition-colors duration-200 hover:bg-paper-subtle [&::-webkit-details-marker]:hidden">
          支援の3原則
          <svg class="h-4 w-4 flex-none transition-transform duration-200 group-open:rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ol class="space-y-4 px-6 pt-1 pb-6">
          {supportPrinciples.map((principle, i) => (
            <li class="flex gap-4">
              <span
                class="flex h-9 w-9 flex-none items-center justify-center rounded-md bg-primary-700 text-sm font-bold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <h4 class="font-semibold text-primary-700">{principle.title}</h4>
                <p class="mt-1 text-sm text-muted">{principle.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </details>
    </div>
  </Section>

  <Section>
    <SectionTitle id="personal">個人向けプログラム</SectionTitle>

    <div class="space-y-6">
      <article class="rounded-lg border border-edge bg-white p-6 md:p-8">
        <p class="mb-2 text-xs font-bold text-primary-500">STEP 0|入口</p>
        <h3 class="mb-3 text-xl font-semibold text-primary-700">個別相談</h3>
        <p class="mb-4 max-w-[42em] text-sm text-muted">
          60分・3,000円・オンライン。「どこから手を付けるか」の見立てを、その場でお渡しします。LINEで「個別相談」と送るだけで始められます。
        </p>
