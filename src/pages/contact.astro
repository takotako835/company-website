---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import Section from '../components/layout/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import LineButton from '../components/ui/LineButton.astro';

// 最重要CVページ。LINE導線を最短・最安心にする(docs/content/contact.md)
// TODO: 法人向けにLINEと別のメールフォームを設けるか要確認(現状は既存運用どおりLINEに一本化)
const steps = [
  {
    title: 'LINEで「個別相談」と送る',
    body: '「個別相談」の4文字を送るだけ。約30秒で完了します。',
  },
  {
    title: '予約フォームが届く',
    body: 'ご都合のよい枠を選ぶだけで大丈夫です。',
  },
  {
    title: 'お支払いのご案内',
    body: '予約確認後に、お支払い方法をご案内します。',
  },
];
---

<Base
  title="個別相談・お問い合わせ"
  description="個別相談は60分・3,000円・オンライン。LINEで「個別相談」と送るだけで始められます。売り込みはしません。法人研修・料金のご相談もこちらから。"
>
  <Breadcrumb items={[{ label: '個別相談・お問い合わせ' }]} />

  <div class="mx-auto max-w-[800px] px-5 pt-8 pb-16 md:pt-12 md:pb-24 lg:px-10">
    <p class="mb-4 inline-block rounded-full bg-primary-100 px-4 py-1.5 text-xs font-bold text-primary-700">
      個別相談|60分・3,000円・オンライン
    </p>
    <h1 class="text-[28px] font-bold md:text-4xl">まず、話してみませんか</h1>
    <p class="mt-6 max-w-[42em]">
      売り込みはしません。60分の個別相談(3,000円)で、あなたの現場の「どこから手を付けるか」の見立てを、その場で必ずお渡しします。まとまっていない相談ほど、歓迎です。相談だけで終えていただいて構いません。
    </p>
  </div>

  <Section tone="subtle" narrow>
    <SectionTitle>お申し込みの流れ</SectionTitle>
    <ol class="mb-10 space-y-4">
      {steps.map((step, i) => (
        <li class="flex gap-4 rounded-lg border border-edge bg-white p-5">
          <span
            class="flex h-9 w-9 flex-none items-center justify-center rounded-md bg-primary-700 text-sm font-bold text-white"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div>
            <h3 class="font-semibold text-primary-700">{step.title}</h3>
            <p class="mt-1 text-sm text-muted">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <LineButton class="mx-auto max-w-md" />
    <p class="mt-4 text-center text-xs leading-relaxed text-muted">
      会社を通さず、個人のままお申し込みいただけます(企業のチーム研修も承っています)。<br />
      合わないと感じたら、そこで終わりにして大丈夫です。
    </p>
  </Section>

  <Section narrow>
    <SectionTitle>法人のご相談・料金のお問い合わせ</SectionTitle>
    <p class="mb-4 max-w-[42em]">
      チーム研修・プロジェクト伴走支援のご相談、プログラム料金・お見積りのご相談もこちらからどうぞ。検討段階のご相談も歓迎です。お見積りは内容を伺ったうえで個別にご案内します。
    </p>
    <p class="mb-8 max-w-[42em] text-sm text-muted">
      LINEで「個別相談」と送っていただいたあと、メッセージで「法人研修について」「料金について」などご用件をお知らせください。
    </p>
    <LineButton class="mx-auto max-w-md" />
  </Section>
</Base>
