---
import Base from '../../layouts/Base.astro';
import { checkPassword, createSessionCookie, isAuthenticated } from '../../lib/analytics/auth';
import {
  diagnose,
  diagnoseWrite,
  fetchEvents,
  readAnalyticsConfig,
  sbFetch,
  type TableDiagnosis,
} from '../../lib/analytics/db';
import { buildDashboard, type Dashboard, type EventRow } from '../../lib/analytics/stats';

// 管理画面。ADMIN_PASSWORD で保護し、検索エンジンには載せない
let loginError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  const password = form?.get('password');
  if (typeof password === 'string' && checkPassword(password)) {
    const cookie = createSessionCookie();
    if (cookie) {
      return new Response(null, {
        status: 303,
        headers: { Location: '/admin/', 'Set-Cookie': cookie },
      });
    }
  }
  loginError = 'パスワードが違います。';
}

const authed = isAuthenticated(Astro.request.headers.get('cookie'));
const analyticsReady = readAnalyticsConfig() !== null;
const adminReady = Boolean(process.env.ADMIN_PASSWORD?.trim());

const DAYS = 14;
let dashboard: Dashboard | null = null;
let reports: { period_start: string; period_end: string; summary_md: string }[] = [];
let abConfigNote = '';
let diagnostics: TableDiagnosis[] = [];
let effectiveUrl = '';
let rawUrl = '';
let keyKind = '';

if (authed && analyticsReady) {
  const config = readAnalyticsConfig()!;
  const since = new Date(Date.now() - DAYS * 86400000).toISOString();
  const events = (await fetchEvents(config, since)) as unknown as EventRow[];
  dashboard = buildDashboard(events);

  // データが0件のときは、つながらない理由を突き止めて画面に出す
  if (events.length === 0) {
    diagnostics = [...(await diagnose(config)), await diagnoseWrite(config)];
    effectiveUrl = config.url;
    rawUrl = process.env.SUPABASE_URL?.trim() ?? '';
    keyKind = process.env.SUPABASE_SERVICE_ROLE_KEY?.trim().startsWith('sb_publishable_')
      ? 'publishable(誤り。Secret key を設定してください)'
      : 'secret(正しい種類)';
  }

  const reportRows = await sbFetch(config, 'reports?select=period_start,period_end,summary_md&order=created_at.desc&limit=8');
  if (reportRows.ok) reports = reportRows.rows as typeof reports;

  const abRows = await sbFetch(config, 'ab_config?select=key,status,winner');
  if (abRows.ok) {
    const hero = (abRows.rows as { key: string; status: string; winner: string | null }[]).find(
      (r) => r.key === 'hero_value_prop',
    );
    abConfigNote = hero?.status === 'done' ? `勝者確定: ${hero.winner}案(全訪問者に配信中)` : 'テスト配信中(週次分析で自動判定)';
  }
}

const maxDailySessions = Math.max(1, ...(dashboard?.daily.map((d) => d.sessions) ?? [1]));
const cell = 'rounded-lg border border-edge bg-white p-4';
const th = 'px-3 py-2 text-left text-xs font-bold text-muted';
const td = 'px-3 py-2 border-t border-edge';
---

<Base title="管理画面" description="アクセス計測の管理画面です。" noindex>
  <div class="mx-auto max-w-[1120px] px-5 py-10 lg:px-10">
    {!authed ? (
      <div class="mx-auto max-w-sm">
        <h1 class="text-2xl font-bold">管理画面</h1>
        {!adminReady ? (
          <p class="mt-6 rounded-lg border border-edge bg-white p-5 text-sm text-muted">
            環境変数 ADMIN_PASSWORD が未設定のため、管理画面は無効です。設定手順は docs/08_analytics-improvement.md を参照してください。
          </p>
        ) : (
          <form method="POST" class="mt-6 space-y-4">
            <div>
              <label for="password" class="mb-2 block text-sm font-bold">パスワード</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                class="w-full rounded-md border border-edge bg-white p-4"
              />
            </div>
            {loginError && <p class="text-sm text-error" role="alert">{loginError}</p>}
            <button type="submit" class="w-full rounded-md bg-primary-700 px-8 py-4 font-bold text-white">
              ログイン
            </button>
          </form>
        )}
      </div>
    ) : !analyticsReady ? (
      <p class="rounded-lg border border-edge bg-white p-5 text-sm text-muted">
        Supabase が未設定です(SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY)。設定手順は docs/08_analytics-improvement.md を参照してください。
      </p>
    ) : (
      dashboard && (
        <div class="space-y-10">
          <div>
            <h1 class="text-2xl font-bold">管理画面</h1>
            <p class="mt-1 text-sm text-muted">直近{DAYS}日間の計測(ボットは除外済み)</p>
          </div>

          {diagnostics.length > 0 && (
            <section aria-label="接続診断" class="rounded-lg border-2 border-error bg-white p-6">
              <h2 class="text-lg font-bold text-error">データが0件です — 接続診断</h2>
              <p class="mt-1 mb-4 text-sm text-muted">
                Supabase との通信を実際に試した結果です。NGの行の内容にしたがって設定を直してください。
              </p>
              <dl class="mb-4 grid gap-1 rounded-md bg-paper-subtle p-4 text-xs sm:grid-cols-[10em_1fr]">
                <dt class="font-bold text-muted">設定されたURL</dt>
                <dd class="break-all">{rawUrl || '(未設定)'}</dd>
                <dt class="font-bold text-muted">実際の接続先</dt>
                <dd class="break-all">{effectiveUrl}/rest/v1/…</dd>
                <dt class="font-bold text-muted">キーの種類</dt>
                <dd>{keyKind}</dd>
              </dl>
              <ul class="space-y-2 text-sm">
                {diagnostics.map((d) => (
                  <li class="flex flex-col gap-1 border-t border-edge pt-2 sm:flex-row sm:items-baseline sm:gap-3">
                    <span class={`flex-none font-bold ${d.ok ? 'text-success' : 'text-error'}`}>
                      {d.ok ? 'OK' : 'NG'}
                    </span>
                    <span class="flex-none font-bold">{d.table}</span>
                    <span class="flex-none text-muted tabular-nums">HTTP {d.status}</span>
                    <span class="text-muted">{d.detail}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-xs text-muted">
                すべてOKなのに0件の場合は、まだ誰もサイトを訪問していないだけです(自分でサイトを開いて確認してください)。
              </p>
            </section>
          )}

          <section aria-label="サマリー">
            <div class="grid grid-cols-2 gap-3 md:grid-cols-6">
              {[
                ['訪問者', String(dashboard.totals.sessions)],
                ['ページビュー', String(dashboard.totals.pageviews)],
                ['LINEタップ', String(dashboard.totals.lineClicks)],
                ['フォーム送信', String(dashboard.totals.formSubmits)],
                ['CVR', `${dashboard.totals.cvr}%`],
                ['モバイル率', `${dashboard.totals.mobileShare}%`],
              ].map(([label, value]) => (
                <div class={cell}>
                  <p class="text-xs font-bold text-muted">{label}</p>
                  <p class="mt-1 text-2xl font-bold text-primary-700 tabular-nums">{value}</p>
                </div>
              ))}
            </div>
          </section>

          <section aria-label="日別の訪問とCV">
            <h2 class="mb-3 text-lg font-bold">日別の訪問者とCV</h2>
            <div class={cell}>
              <svg viewBox={`0 0 ${DAYS * 34} 120`} class="w-full" role="img" aria-label="日別グラフ">
                {dashboard.daily.map((d, i) => {
                  const h = Math.round((d.sessions / maxDailySessions) * 90);
                  const hc = Math.round((d.cv / maxDailySessions) * 90);
                  return (
                    <g>
                      <rect x={i * 34 + 4} y={100 - h} width="18" height={h} fill="var(--color-primary-500)" opacity="0.35" />
                      <rect x={i * 34 + 4} y={100 - hc} width="18" height={hc} fill="var(--color-brand-orange)" />
                      <text x={i * 34 + 13} y="114" text-anchor="middle" font-size="8" fill="var(--color-muted)">
                        {d.day.slice(5)}
                      </text>
                    </g>
                  );
                })}
              </svg>
              <p class="mt-2 text-xs text-muted">青 = 訪問者 / オレンジ = CVした訪問者</p>
            </div>
          </section>

          <div class="grid gap-6 lg:grid-cols-2">
            <section aria-label="診断ファネル" class={cell}>
              <h2 class="mb-3 text-lg font-bold">診断ファネル</h2>
              <ol class="space-y-2 text-sm">
                {[
                  ['診断を開始', dashboard.funnelShindan.start],
                  ['結果を表示', dashboard.funnelShindan.result],
                  ['LINEをタップ', dashboard.funnelShindan.lineClick],
                ].map(([label, count], i, arr) => (
                  <li class="flex items-center justify-between gap-3">
                    <span>{i + 1}. {label}</span>
                    <span class="font-bold tabular-nums">
                      {count}
                      {i > 0 && Number(arr[i - 1]![1]) > 0 && (
                        <span class="ml-2 text-xs text-muted">({Math.round((Number(count) / Number(arr[i - 1]![1])) * 100)}%)</span>
                      )}
                    </span>
                  </li>
                ))}
              </ol>
            </section>

            <section aria-label="フォームファネル" class={cell}>
              <h2 class="mb-3 text-lg font-bold">フォームファネル</h2>
              <ol class="space-y-2 text-sm">
                {[
                  ['フォームを表示', dashboard.funnelForm.view],
                  ['入力を開始', dashboard.funnelForm.start],
                  ['送信完了', dashboard.funnelForm.submit],
                ].map(([label, count], i, arr) => (
                  <li class="flex items-center justify-between gap-3">
                    <span>{i + 1}. {label}</span>
                    <span class="font-bold tabular-nums">
                      {count}
                      {i > 0 && Number(arr[i - 1]![1]) > 0 && (
                        <span class="ml-2 text-xs text-muted">({Math.round((Number(count) / Number(arr[i - 1]![1])) * 100)}%)</span>
                      )}
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          </div>

          <div class="grid gap-6 lg:grid-cols-2">
            <section aria-label="流入元">
              <h2 class="mb-3 text-lg font-bold">流入元(訪問者ベース)</h2>
              <table class="w-full overflow-hidden rounded-lg border border-edge bg-white text-sm">
                <thead><tr><th class={th}>流入元</th><th class={th}>訪問者</th><th class={th}>CV</th></tr></thead>
                <tbody>
                  {dashboard.sources.map((s) => (
                    <tr><td class={td}>{s.source}</td><td class={`${td} tabular-nums`}>{s.sessions}</td><td class={`${td} tabular-nums`}>{s.cv}</td></tr>
                  ))}
                </tbody>
              </table>
            </section>

            <section aria-label="ページ別">
              <h2 class="mb-3 text-lg font-bold">ページ別</h2>
              <table class="w-full overflow-hidden rounded-lg border border-edge bg-white text-sm">
                <thead><tr><th class={th}>パス</th><th class={th}>PV</th><th class={th}>LINEタップ</th></tr></thead>
                <tbody>
                  {dashboard.pages.map((p) => (
                    <tr><td class={`${td} break-all`}>{p.path}</td><td class={`${td} tabular-nums`}>{p.pageviews}</td><td class={`${td} tabular-nums`}>{p.lineClicks}</td></tr>
                  ))}
                </tbody>
              </table>
            </section>
          </div>

          <div class="grid gap-6 lg:grid-cols-3">
            <section aria-label="診断タイプ" class={cell}>
              <h2 class="mb-3 text-lg font-bold">診断タイプ分布</h2>
              <ul class="space-y-1 text-sm">
                {dashboard.shindanTypes.length === 0 && <li class="text-muted">まだデータがありません</li>}
                {dashboard.shindanTypes.map((t) => (
                  <li class="flex justify-between"><span>タイプ{t.type}</span><span class="font-bold tabular-nums">{t.count}</span></li>
                ))}
              </ul>
            </section>

            <section aria-label="LINEタップ位置" class={cell}>
              <h2 class="mb-3 text-lg font-bold">LINEタップの位置</h2>
              <ul class="space-y-1 text-sm">
                {dashboard.lineClickLocs.length === 0 && <li class="text-muted">まだデータがありません</li>}
                {dashboard.lineClickLocs.map((l) => (
                  <li class="flex justify-between"><span>{l.loc}</span><span class="font-bold tabular-nums">{l.count}</span></li>
                ))}
              </ul>
            </section>

            <section aria-label="表示速度" class={cell}>
              <h2 class="mb-3 text-lg font-bold">表示速度(実測 p75)</h2>
              <ul class="space-y-1 text-sm">
                <li class="flex justify-between"><span>LCP</span><span class="font-bold tabular-nums">{dashboard.vitals.lcpP75}ms</span></li>
                <li class="flex justify-between"><span>CLS</span><span class="font-bold tabular-nums">{dashboard.vitals.clsP75}</span></li>
                <li class="flex justify-between"><span>INP</span><span class="font-bold tabular-nums">{dashboard.vitals.inpP75}ms</span></li>
                <li class="flex justify-between text-muted"><span>サンプル数</span><span class="tabular-nums">{dashboard.vitals.samples}</span></li>
              </ul>
            </section>
          </div>

          <section aria-label="A/Bテスト">
            <h2 class="mb-1 text-lg font-bold">A/Bテスト: Hero提供価値の一文</h2>
            <p class="mb-3 text-sm text-muted">{abConfigNote}</p>
            <table class="w-full overflow-hidden rounded-lg border border-edge bg-white text-sm">
              <thead><tr><th class={th}>案</th><th class={th}>訪問者</th><th class={th}>CV</th><th class={th}>CVR</th></tr></thead>
              <tbody>
                {dashboard.ab.length === 0 && <tr><td class={`${td} text-muted`} colspan="4">まだデータがありません</td></tr>}
                {dashboard.ab.map((v) => (
                  <tr><td class={td}>{v.variant}案</td><td class={`${td} tabular-nums`}>{v.sessions}</td><td class={`${td} tabular-nums`}>{v.cv}</td><td class={`${td} tabular-nums`}>{v.cvr}%</td></tr>
                ))}
              </tbody>
            </table>
          </section>

          <section aria-label="週次レポート">
            <h2 class="mb-3 text-lg font-bold">週次レポート</h2>
            {reports.length === 0 && <p class="text-sm text-muted">まだレポートがありません(毎週月曜に自動生成されます)。</p>}
            <div class="space-y-4">
              {reports.map((r) => (
                <details class="rounded-lg border border-edge bg-white">
                  <summary class="cursor-pointer list-none p-4 text-sm font-bold">
                    {r.period_start} 〜 {r.period_end}
                  </summary>
                  <pre class="overflow-x-auto border-t border-edge p-4 text-xs leading-relaxed whitespace-pre-wrap">{r.summary_md}</pre>
                </details>
              ))}
            </div>
          </section>
        </div>
      )
    )}
  </div>
</Base>
