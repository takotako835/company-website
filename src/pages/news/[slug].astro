---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import { SITE, formatDate } from '../../lib/site';

// SSR のため getStaticPaths は使わず、リクエストごとにスラッグから記事を引く
const { slug } = Astro.params;
const entry = slug ? await getEntry('news', slug) : undefined;

// 存在しない記事・下書きは404を返す(下書きが公開URLで見えないようにする)
if (!entry || entry.data.draft) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(entry);
const dateIso = entry.data.date.toISOString().slice(0, 10);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  datePublished: dateIso,
  author: { '@type': 'Organization', name: SITE.companyName },
  publisher: { '@type': 'Organization', name: SITE.companyName },
};

// 記事のdescriptionは本文冒頭から生成(Markdown記法を除いた素のテキスト)
const description = entry.body
  ? entry.body.replace(/[#*\[\]()>\-\n]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 110)
  : entry.data.title;
---

<Base title={entry.data.title} description={description} jsonLd={[articleLd]}>
  <Breadcrumb
    items={[{ label: 'お知らせ', href: '/news/' }, { label: entry.data.title }]}
  />

  <article class="mx-auto max-w-[800px] px-5 py-12 md:py-16 lg:px-10">
    <header class="mb-10 border-b border-edge pb-8">
      <div class="mb-3 flex items-center gap-3 text-sm">
        <time datetime={dateIso} class="text-muted">{formatDate(entry.data.date)}</time>
        <span class="rounded-sm bg-paper-subtle px-2 py-0.5 text-xs font-bold text-muted">
          {entry.data.category}
        </span>
      </div>
      <h1 class="text-[26px] font-bold md:text-3xl">{entry.data.title}</h1>
    </header>

    <div class="news-body">
      <Content />
    </div>

    <p class="mt-12">
      <a
        href="/news/"
        class="text-sm font-bold text-primary-700 underline-offset-4 hover:underline"
      >
        ← お知らせの一覧に戻る
      </a>
    </p>
  </article>
</Base>
