---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import Section from '../../components/layout/Section.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { formatDate } from '../../lib/site';

const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
// TODO: 記事が10件を超えたらページネーションを追加する(docs/content/news.md)
---

<Base
  title="お知らせ"
  description="maido&crafts strategy株式会社からのお知らせ・プレスリリースの一覧です。"
>
  <Breadcrumb items={[{ label: 'お知らせ' }]} />

  <div class="mx-auto max-w-[800px] px-5 pt-8 pb-8 md:pt-12 lg:px-10">
    <h1 class="text-[28px] font-bold md:text-4xl">お知らせ</h1>
  </div>

  <Section narrow>
    {news.length === 0 ? (
      <p class="text-muted">現在、お知らせはありません。</p>
    ) : (
      <ul class="divide-y divide-edge rounded-lg border border-edge bg-white">
        {news.map((item) => (
          <li>
            <a
              href={`/news/${item.id}/`}
              class="flex flex-col gap-1 px-6 py-4 transition-colors duration-200 hover:bg-paper-subtle sm:flex-row sm:items-center sm:gap-4"
            >
              <time
                datetime={item.data.date.toISOString().slice(0, 10)}
                class="flex-none text-sm text-muted"
              >
                {formatDate(item.data.date)}
              </time>
              <span class="flex-none rounded-sm bg-paper-subtle px-2 py-0.5 text-xs font-bold text-muted">
                {item.data.category}
              </span>
              <span class="font-medium">{item.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </Section>

  <CtaSection />
</Base>
