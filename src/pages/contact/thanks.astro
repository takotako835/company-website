---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';

// 送信完了ページ。返信の目安を明記して不安を解消する(03_ux-guidelines §5)
// TODO: 返信の目安日数はユーザー確認のうえ確定する(暫定で3営業日以内としています)
---

<Base
  title="お問い合わせを受け付けました"
  description="お問い合わせいただきありがとうございます。3営業日以内にご返信します。"
  noindex
>
  <Breadcrumb
    items={[
      { label: '個別相談・お問い合わせ', href: '/contact/' },
      { label: '送信完了' },
    ]}
  />

  <div class="mx-auto max-w-[800px] px-5 py-16 md:py-24 lg:px-10">
    <div class="rounded-lg border border-edge bg-white p-8 text-center md:p-12">
      <span
        class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-primary-100"
        aria-hidden="true"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-700">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </span>

      <h1 class="text-2xl font-bold md:text-[28px]">お問い合わせを受け付けました</h1>

      <p class="mx-auto mt-6 max-w-[36em] text-left md:text-center">
        お問い合わせいただき、ありがとうございます。内容を確認のうえ、<strong>3営業日以内</strong>にご記入いただいたメールアドレスへご返信します。
      </p>

      <div class="mx-auto mt-8 max-w-[36em] rounded-md bg-paper-subtle p-5 text-left text-sm text-muted">
        <p class="mb-2 font-bold text-ink">返信が届かない場合</p>
        <p>
          迷惑メールフォルダに振り分けられている可能性があります。3営業日を過ぎても届かない場合は、お手数ですがLINEからご連絡ください。
        </p>
      </div>

      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
        <Button href="/">トップページへ</Button>
        <Button href="/services/" variant="secondary">サービスを見る</Button>
      </div>
    </div>
  </div>
</Base>
