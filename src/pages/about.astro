---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import Section from '../components/layout/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Button from '../components/ui/Button.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import Positioning from '../components/sections/Positioning.astro';
import VoicesStats from '../components/sections/VoicesStats.astro';
import { SITE } from '../lib/site';

// 経営理念の体系(会社説明資料 p.3 より。title/body の文言は資料のまま)。
// vow は各指針を「お客様への約束」に読み替えたもの(2026年9月7日 改善版ドラフト承認済み)
const principles = [
  {
    title: '人は係数として機能することを理解する',
    body: '人の能力開発への投資が、すべての資源(ヒト・モノ・カネ・情報)の価値を何倍にも高めることを認識します。',
    vow: 'あなたを「コスト」ではなく「可能性」として扱います。',
  },
  {
    title: '成長の喜びを分かち合う',
    body: '自分自身が成長する喜びを知り、その体験を他者と共有することで、学びの連鎖を生み出します。',
    vow: 'あなたの小さな前進に気づいて、一緒に喜びます。',
  },
  {
    title: '基礎を大切にする',
    body: 'どんな専門分野でも応用できるポータブルスキルの習得を重視し、変化に強い人材を育成します。',
    vow: '業種や職種が変わっても使える、長持ちする土台をお渡しします。',
  },
  {
    title: '実践と教育を循環させる',
    body: '理論だけの学びではなく、実践を通じた経験と内省のサイクルを大切にします。',
    vow: '学んで終わりにしません。現場で使えるようになるまで、お付き合いします。',
  },
  {
    title: '社会への貢献を目指す',
    body: '個人と組織の成長が最終的に社会全体の発展につながることを常に意識します。',
    vow: 'あなたの成長は、やがて次の誰かを育てます。その連鎖を信じています。',
  },
];

// 「人を遺す」という指針(後藤新平の遺訓として伝えられる言葉。代表の事業への思い)
const legacyQuote = [
  '金を残して死ぬ者は下だ。',
  '仕事を残して死ぬ者は中だ。',
  '人を残して死ぬ者は上だ。',
];

const legacyLadder = [
  { rank: '下', label: 'お金を残す', body: '短期的な成果や、資産。', top: false },
  { rank: '中', label: '事業を残す', body: '仕組み、顧客基盤、そして組織。', top: false },
  { rank: '上', label: '人を遺す', body: '次の経営者、リーダー、専門家を育てること。', top: true },
];

// 会社概要テーブル(docs/content/about.md §6)。所在地は特商法表記と同じものを使う
const overview = [
  ['社名', SITE.companyName],
  ['代表', '玉岡 諒太(代表取締役・創業者)'],
  ['設立', '2024年12月'],
  ['所在地', SITE.address],
  [
    '事業内容',
    '個人向け: ポータブルスキル勉強会、1on1コーチング、個別相談 / 法人向け: チーム研修、プロジェクト伴走支援・コンサルティング',
  ],
  ['ミッション', SITE.mission],
];
---

<Base
  title="会社案内"
  description="「まいど！」の温かさを現代の組織に。教育×実践×リフレクションで、「知っている」を「現場で使える」に変える伴走支援を行う、maido&crafts strategy株式会社の会社案内です。"
>
  <Breadcrumb items={[{ label: '会社案内' }]} />

  <div class="mx-auto max-w-[1120px] px-5 pt-10 pb-16 md:pt-16 md:pb-24 lg:px-10">
    <h1 class="text-[28px] font-bold md:text-4xl">会社案内</h1>
    <p class="mt-6 text-xl font-bold text-primary-700 md:text-2xl">
      人の成長が、価値を倍増させる。
    </p>
    <p class="mt-4 max-w-[42em]">
      はじめまして。このページには、私たちがどんな会社で、なぜこの仕事をしているのかをまとめました。5分ほどで読めます。読み終えたとき、<strong>「一度、話してみようかな」</strong>と思っていただけたら、うれしいです。
    </p>
  </div>

  <Section tone="subtle" narrow>
    <SectionTitle>「まいど！」に込めた想い</SectionTitle>
    <div class="rounded-lg border border-edge bg-white p-6 md:p-8">
      <p class="mb-4 text-lg font-bold text-primary-700">「まいど！最近、元気ないな？」</p>
      <p class="mb-4">
        代表の玉岡が育った大阪の商店街では、こんな声が毎日飛び交っていました。八百屋さんは体調を気遣い、魚屋さんは「兄ちゃん、大きくなったなぁ」と成長を喜んでくれる。そこにあったのは、売買を超えて<strong>互いの成長を喜び合う文化</strong>でした。
      </p>
      <p class="mb-4">
        いま、あなたの職場に、こんな声はあるでしょうか。頑張っているのに、誰にも見守られていない。私たちは仕事の中で、そんなリーダーにたくさん出会ってきました。
      </p>
      <p>
        この温かさを、現代の組織に再現したい。商店街のおっちゃん、おばちゃんが若者を見守り育てたように、私たちは組織と個人の持続的な成長を支援します。
      </p>
    </div>
    <p class="mt-6">
      <a
        href="/story/"
        class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline-offset-4 hover:underline"
      >
        この原点から続く物語「私たちがこの仕事をする理由」を読む →
      </a>
    </p>
  </Section>

  {/* 縦書きの遺訓: 明治の言葉に合わせた、サイトで一度きりのネイビー全幅セクション */}
  <section id="legacy" class="bg-primary-900">
    <div class="mx-auto max-w-[1120px] px-5 py-20 md:py-28 lg:px-10">
      <p class="text-center text-xs font-bold tracking-[0.24em] text-white/70">
        代表が事業に込める思い
      </p>
      <div
        class="mt-12 flex flex-row-reverse items-start justify-center gap-8 md:mt-16 md:gap-14"
        data-reveal
      >
        {legacyQuote.map((line, i) => (
          <p
            class:list={[
              '[writing-mode:vertical-rl] whitespace-nowrap text-lg font-bold tracking-[0.16em] md:text-2xl',
              i === 2
                ? 'text-white underline decoration-brand-orange decoration-2 underline-offset-8'
                : 'text-white/80',
              i === 1 && 'mt-6 md:mt-8',
              i === 2 && 'mt-12 md:mt-16',
            ]}
          >
            {line}
          </p>
        ))}
      </div>
      <p class="mt-12 text-center text-xs text-white/70 md:mt-16">
        ── 後藤新平の言葉として伝えられる遺訓
      </p>
    </div>
  </section>

  <Section tone="subtle">
    <SectionTitle>「人を遺す」という指針</SectionTitle>
    <p class="mb-4 max-w-[42em]">
      後藤新平は、明治から昭和初期にかけて活躍した政治家・医師です。東京市長、初代満鉄総裁、内務大臣などを歴任しました。事業や資産そのものよりも、次代を担う人を育て、遺すことにこそ最も大きな価値がある──この言葉には、そんな思いが込められています。
    </p>
    <p class="mb-8 max-w-[42em] text-muted">経営の言葉に置き換えると、こうなります。</p>
    <div class="grid gap-4 md:grid-cols-3 md:gap-6" data-reveal="group">
      {legacyLadder.map((step) => (
        <div
          class:list={[
            'rounded-lg border p-6',
            step.top ? 'border-primary-700 bg-primary-700 text-white' : 'border-edge bg-white',
            step.rank === '中' && 'md:mt-8',
            step.rank === '下' && 'md:mt-16',
          ]}
        >
          <p class="flex items-center gap-3">
            <span
              class:list={[
                'flex h-9 w-9 flex-none items-center justify-center rounded-full text-sm font-bold',
                step.top ? 'bg-brand-orange text-white' : 'bg-paper-subtle text-muted',
              ]}
            >
              {step.rank}
            </span>
            <span class="text-lg font-bold">{step.label}</span>
          </p>
          <p class:list={['mt-3 text-sm', step.top ? 'text-white/90' : 'text-muted']}>
            {step.body}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-lg border border-edge bg-white p-8 text-center md:p-10" data-reveal>
      <p class="mx-auto max-w-[26em] text-lg font-bold text-balance text-primary-700 md:text-xl">
        自分が抜けても、自ら判断し、顧客価値を生み、さらに人を育てられる人を遺せるか。
      </p>
      <p class="mt-4 text-sm text-muted">
        私たちは、この問いを事業として突き詰めていきます。
      </p>
    </div>

    <p class="mx-auto mt-10 max-w-[42em]" data-reveal>
      だから、私たちのプログラムは、代行ではなく伴走を。答えではなく、ご自身で再現できる考え方と行動の型をお渡しします。「人を遺す」こと。それが、すべての支援に共通するゴールです。
    </p>
    <p class="mx-auto mt-4 max-w-[42em]" data-reveal>
      企業のご支援でも同じです。私たちが去ったあとに残るのは、報告書ではなく、自分たちで考えて進められる人と、そのやり方です。
    </p>

    {/* 感情が動いた直後の受け皿(中間CTA)。控えめに一つだけ置く */}
    <div class="mx-auto mt-12 max-w-[42em] rounded-lg border border-edge bg-white p-6 text-center" data-reveal>
      <p class="text-sm">ここまで読んで、少し話してみたくなった方へ。<strong>売り込みはしません。</strong></p>
      <p class="mt-2">
        <a
          href="/contact/"
          data-track="cta_contact_click"
          data-loc="about_mid"
          class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline underline-offset-4"
        >
          個別相談・お問い合わせ →
        </a>
      </p>
    </div>
  </Section>

  <Section narrow>
    <SectionTitle>ミッション・ビジョン・行動指針</SectionTitle>
    <div class="space-y-6">
      <div class="rounded-lg border border-edge bg-white p-6" data-reveal>
        <p class="mb-2 text-xs font-bold tracking-widest text-primary-500">ミッション(使命)</p>
        <p class="leading-loose">
          成長の土台となるポータブルスキルを構築し、個人と組織の持続的な発展を促進することで、社会に貢献できる人材を輩出します。
        </p>
        <p class="mt-4 border-t border-edge pt-4 text-sm font-bold leading-loose text-primary-700">
          つまり ── どこの会社でも通用する仕事の土台をあなたと一緒につくり、あなたが誰かを育てる側になるまで伴走する、ということです。
        </p>
      </div>
      <div class="rounded-lg border border-edge bg-white p-6" data-reveal>
        <p class="mb-2 text-xs font-bold tracking-widest text-primary-500">ビジョン(目指す姿)</p>
        <p class="leading-loose">
          すべての人が自らの成長を実感し、その喜びを仕事に見出せる社会を創造します。「教育と実践の融合」というアプローチで、人と組織の可能性を最大限に引き出す最高のパートナーとなります。
        </p>
        <p class="mt-4 border-t border-edge pt-4 text-sm font-bold leading-loose text-primary-700">
          目指しているのは、「成長がうれしい」と言える人と職場を、この国に増やすことです。
        </p>
      </div>
      <div data-reveal>
        <p class="mb-2 text-xs font-bold tracking-widest text-primary-500">行動指針</p>
        <p class="mb-4 text-sm text-muted">
          行動指針は、お客様への約束でもあると考えています。それぞれの指針が、あなたにとって何を意味するのかを添えました。
        </p>
        <ol class="space-y-3">
          {principles.map((principle, i) => (
            <li class="flex gap-4 rounded-lg border border-edge bg-white p-5">
              <span
                class="flex h-8 w-8 flex-none items-center justify-center rounded-md bg-primary-700 text-sm font-bold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <h3 class="font-semibold text-primary-700">{principle.title}</h3>
                <p class="mt-1 text-sm text-muted">{principle.body}</p>
                <p class="mt-2 text-sm font-bold text-primary-700">
                  <span class="text-brand-teal" aria-hidden="true">→ </span>{principle.vow}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Section>

  <Section tone="subtle" narrow>
    <SectionTitle>なぜ「ポータブルスキル」なのか</SectionTitle>
    <p class="mb-4">
      成果を出せない真の原因は、多くの場合、専門知識ではなく<strong>ポータブルスキルの欠如</strong>にあります。現状分析力、問題解決力、目標設定力、コミュニケーション力。業種や職種が変わっても持ち運べる、価値を生み出す実践的能力です。
    </p>
    <p class="mb-4">
      専門知識は仕事をすれば自然と身につきます。しかしポータブルスキルは、自ら機会をつくらない限り、いつまでも身につきません。私たちはこの「土台」を、専門知識の<strong>価値倍増装置</strong>として育てます。
    </p>
    <p class="text-xs text-muted">
      ※「ポータブルスキル」は厚生労働省も定義・推進する概念です(業種や職種が変わっても持ち運びができる職務遂行上のスキル)。
    </p>
    <p class="mt-6">
      <a
        href="/portable-skills/"
        class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline-offset-4 hover:underline"
      >
        ポータブルスキルの解説を読む(定義・代表例・重要性) →
      </a>
    </p>
  </Section>

  <Section>
    <SectionTitle>私たちのやり方</SectionTitle>
    <p class="mb-8 max-w-[42em]">
      知識を教えて終わりにはしません。教育 × 実践 × リフレクションの循環で、<strong>「わかる」を「できる」に変えます。</strong>
    </p>
    <MethodSteps />
    <p class="mt-6 text-sm text-muted">
      受講アンケートには「毎回楽しく参加できた」という声が並びます。学びは、しかめっ面でやるものではないと思っています。
    </p>
  </Section>

  <Section tone="subtle">
    <SectionTitle>研修でも、コンサルでもなく</SectionTitle>
    <Positioning />
  </Section>

  <Section>
    <SectionTitle>数字と、声。</SectionTitle>
    <VoicesStats />
  </Section>

  {/* 未来を語る、感情のクライマックス。事実の主張はせず、目指す情景と信念だけを書く */}
  <Section tone="subtle" narrow>
    <SectionTitle>私たちが見ている未来</SectionTitle>
    <div class="space-y-6" data-reveal>
      <p>私たちが見ているのは、そう遠くない未来です。</p>
      <p>
        月曜の朝の会議で、若手が自分の言葉で論点を語りはじめる。任せた仕事が、思っていたより良い形になって返ってくる。「あの人がいないと回らない」ではなく、<strong>「あの人のおかげで、みんなができるようになった」</strong>と言われる人が、組織の真ん中で笑っている。
      </p>
      <p>
        商店街に「まいど!」が飛び交っていたように、職場に、互いの成長を喜び合う声が戻ってくる。教えることが誇りになり、育つことが楽しみになる。私たちは、そんな組織をこの国に増やしたいと、本気で考えています。
      </p>
      <p>
        大きな話に聞こえるかもしれません。それでも、変化はいつも、ひとりから始まります。ひとりの考え方が変わると、行動が変わる。その姿を見て、隣の人が変わる。やがてチームが変わり、組織が変わっていく。人の成長は、人から人へと響き合う──私たちは、その連鎖を信じています。
      </p>
      <p>
        だから今日も、目の前のひとりに全力で伴走します。10年後のあなたが「あのとき、一歩を踏み出してよかった」と笑っていられるように。
      </p>
      <p class="pt-2 font-bold text-primary-700">あなたの現場から、始めませんか。</p>
    </div>
    <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-5" data-reveal>
      <svg
        class="w-full max-w-[520px] text-brand-teal"
        viewBox="0 0 520 26"
        fill="none"
        aria-hidden="true"
      >
        <path d="M1 25h518" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M452 25a15 15 0 0 1 30 0Z" fill="var(--color-brand-orange)" />
      </svg>
      <span class="flex-none text-xs font-bold tracking-[0.24em] text-muted sm:pb-0.5">
        まいど、から始まる未来
      </span>
    </div>
  </Section>

  <Section narrow>
    <SectionTitle>会社概要</SectionTitle>
    <table class="w-full overflow-hidden rounded-lg border border-edge bg-white text-sm">
      <tbody>
        {overview.map(([label, value]) => (
          <tr class="border-b border-edge last:border-b-0">
            <th
              scope="row"
              class="w-[30%] bg-paper-subtle px-4 py-3 text-left align-top font-bold text-muted"
            >
              {label}
            </th>
            <td class="px-4 py-3">{value}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="mt-16 text-center">
      <p class="leading-loose text-muted">
        想いから始まる、すべて。<br />
        理性を超えた情熱が行動を生み、人から人へと響き合う。<br />
        私たちが、その架け橋になります。
      </p>
      <p class="mt-10">
        <Button href="/profile/" variant="secondary">代表プロフィールを見る</Button>
      </p>
    </div>
  </Section>

  <CtaSection />
</Base>
