---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Button from '../components/ui/Button.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import Positioning from '../components/sections/Positioning.astro';
import VoicesStats from '../components/sections/VoicesStats.astro';
import { formatDate } from '../lib/site';
import tamaoka from '../assets/tamaoka.jpg';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const worries = [
  '部下の仕事を、つい巻き取ってしまう',
  '感覚でやってきたことを、うまく教えられない',
  '上司と部下の板挟みで、消耗している',
  '「戦略を考えろ」と言われて、手が止まる',
];

const services = [
  {
    tag: '個人向け',
    title: '社外参謀 1on1ブートキャンプ',
    body: '全4回・マンツーマンで、発言や行動のベースとなる「思考OS」を構築する超実務プログラムです。',
  },
  {
    tag: '個人向け',
    title: '社外参謀 伴走プログラム',
    body: '構築した「思考OS」を現場で実装し、成果を取りに行く3〜6か月の長期プロジェクトです。',
  },
  {
    tag: '法人向け',
    title: 'チーム研修・伴走支援',
    body: '少人数・高密度のチーム研修と、プロジェクト伴走支援。自走できる状態をゴールに設計します。',
  },
];
---

<Base
  description="maido&crafts strategy株式会社は、ポータブルスキルと「思考OS」の構築を、教育×実践×リフレクションで伴走支援します。個別相談は60分・3,000円・オンライン。"
>
  <!-- Hero: タイポグラフィ主体(home.md のビジュアル案から選択) -->
  <div class="bg-white">
    <div class="mx-auto max-w-[1120px] px-5 py-20 md:py-32 lg:px-10">
      <p class="mb-6 text-xs font-bold tracking-[0.18em] text-muted uppercase">
        maido &amp; crafts strategy
      </p>
      <h1 class="text-[32px] leading-[1.3] font-bold md:text-5xl">
        人の成長が、<br class="md:hidden" />価値を倍増させる。
      </h1>
      <p class="mt-6 max-w-[42em] text-base leading-loose text-muted">
        私たちは、人が「係数」として機能することを信じています。同じ予算・設備・情報でも、成果は「人」で何倍にも変わる。だから、人の成長に投資します。
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <Button href="/contact/">個別相談について</Button>
        <Button href="/services/" variant="secondary">サービスを見る</Button>
      </div>
    </div>
  </div>

  <Section tone="subtle">
    <SectionTitle>こんな悩みは、ありませんか</SectionTitle>
    <ul class="grid gap-4 md:grid-cols-2 md:gap-6">
      {worries.map((worry) => (
        <li class="rounded-lg border border-edge bg-white p-6 font-bold text-primary-700">
          {worry}
        </li>
      ))}
    </ul>
    <p class="mt-8 max-w-[42em] text-muted">
      その原因は、あなたの能力ではなく「構造」にあるのかもしれません。
    </p>
    {/* TODO: 30秒診断(既存LP)へ送客するか要確認(docs/content/home.md §2) */}
  </Section>

  <Section>
    <SectionTitle>サービス</SectionTitle>
    <div class="grid gap-4 md:grid-cols-3 md:gap-6">
      {services.map((service) => (
        <div class="flex flex-col rounded-lg border border-edge bg-white p-6">
          <p class="mb-2">
            <span class="rounded-sm bg-primary-100 px-2 py-0.5 text-xs font-bold text-primary-700">
              {service.tag}
            </span>
          </p>
          <h3 class="mb-2 text-lg font-semibold text-primary-700">{service.title}</h3>
          <p class="text-sm text-muted">{service.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center">
      <Button href="/services/" variant="secondary">サービスの詳細を見る</Button>
    </p>
  </Section>

  <Section tone="subtle">
    <SectionTitle>研修でも、コンサルでもなく</SectionTitle>
    <Positioning />
  </Section>

  <Section>
    <SectionTitle>私たちのやり方</SectionTitle>
    <p class="mb-8 max-w-[42em] text-muted">
      知識を教えて終わりにはしません。教育 × 実践 × リフレクションの循環で、「わかる」を「できる」に変えます。
    </p>
    <MethodSteps />
  </Section>

  <Section tone="subtle">
    <SectionTitle>数字と、声。</SectionTitle>
    <VoicesStats />
  </Section>

  <Section>
    <SectionTitle>代表紹介</SectionTitle>
    <div class="flex flex-col items-center gap-8 md:flex-row md:gap-12">
      <Image
        src={tamaoka}
        alt="代表取締役 玉岡諒太の写真"
        width={320}
        height={320}
        class="h-40 w-40 flex-none rounded-full object-cover md:h-48 md:w-48"
      />
      <div>
        <p class="font-bold text-primary-700">玉岡 諒太(代表取締役・創業者)</p>
        <p class="mt-3 max-w-[42em] text-muted">
          大阪の商店街で育ち、富士通・ベイカレント・ベンチャー・NECを経て独立。「作る側」と「支える側」の両方を歩いてきました。
        </p>
        <p class="mt-6">
          <Button href="/profile/" variant="secondary">プロフィールを見る</Button>
        </p>
      </div>
    </div>
  </Section>

  <Section tone="subtle">
    <SectionTitle>お知らせ</SectionTitle>
    {news.length === 0 ? (
      <p class="text-muted">現在、お知らせはありません。</p>
    ) : (
      <ul class="divide-y divide-edge rounded-lg border border-edge bg-white">
        {news.map((item) => (
          <li>
            <a
              href={`/news/${item.id}/`}
              class="flex flex-col gap-1 px-6 py-4 transition-colors duration-200 hover:bg-paper-subtle sm:flex-row sm:items-center sm:gap-4"
            >
              <time datetime={item.data.date.toISOString().slice(0, 10)} class="text-sm text-muted">
                {formatDate(item.data.date)}
              </time>
              <span class="rounded-sm bg-paper-subtle px-2 py-0.5 text-xs font-bold text-muted">
                {item.data.category}
              </span>
              <span class="font-medium">{item.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="mt-6 text-right">
      <a href="/news/" class="text-sm font-bold text-primary-700 underline-offset-4 hover:underline">
        お知らせの一覧を見る
      </a>
    </p>
  </Section>

  <CtaSection />
</Base>
