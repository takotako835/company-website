---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/layout/Section.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Button from '../components/ui/Button.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import MethodSteps from '../components/sections/MethodSteps.astro';
import Positioning from '../components/sections/Positioning.astro';
import VoicesStats from '../components/sections/VoicesStats.astro';
import CaseList from '../components/sections/CaseList.astro';
import { formatDate } from '../lib/site';
import { visitorHash } from '../lib/analytics/db';
import { HERO_VALUE_PROP_VARIANTS, pickVariant } from '../lib/analytics/ab';
import tamaoka from '../assets/tamaoka.jpg';

// Hero提供価値のA/Bテスト(候補は docs/content/home.md で承認済みの3案のみ)
const visitorIp =
  Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() || Astro.clientAddress || '';
const heroVariant = await pickVariant(
  'hero_value_prop',
  visitorHash(visitorIp, Astro.request.headers.get('user-agent') ?? ''),
);
const heroValueProp = HERO_VALUE_PROP_VARIANTS[heroVariant] ?? HERO_VALUE_PROP_VARIANTS.A!;

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// 顧客課題から入る導線。文言は診断LP・会社案内の既存資産から(創作しない)
const personalWorries = [
  '部下の仕事を、つい巻き取ってしまう',
  '感覚でやってきたことを、うまく教えられない',
  '上司と部下の板挟みで、消耗している',
  '「戦略を考えろ」と言われて、手が止まる',
];

const corporateWorries = [
  '研修をやっても、「知る」で終わってしまう',
  '外部に任せると、ノウハウが社内に残らない',
  '若手・中堅が、自走できるチームにしたい',
];

// 身につけたものが、どこまで広がるか。
// 「実績」ではなく「目指す状態」として示す(存在しない成果の創作は禁止事項)
const BAR_WIDTHS = ['w-1/3', 'w-2/3', 'w-full'];

const reachPersonal = [
  { scope: '目の前の仕事で', body: '会議の論点が定まり、提案が前に進みはじめます。' },
  { scope: 'チームと組織で', body: '任せられる範囲が広がり、まわりが育ちはじめます。' },
  { scope: 'キャリアと人生で', body: '次の一手を、自分の言葉で選べるようになります。' },
];

const reachCorporate = [
  { scope: 'ひとりの変化から', body: '研修が「知る」で終わらず、現場の行動が変わりはじめます。' },
  { scope: 'チームの自走へ', body: '自分たちで計画を立て、実行できるようになります。' },
  { scope: '組織に残る型へ', body: '支援が終わっても、やり方が社内に残り続けます。' },
];

// サービスの整理(対象・形式・期間のメタ情報つき)
const personalServices = [
  {
    step: 'STEP 0',
    title: '個別相談',
    meta: '60分・3,000円・オンライン',
    body: '「どこから手を付けるか」の見立てを、その場で必ずお渡しします。相談だけで終えていただいて構いません。',
  },
  {
    step: 'STEP 1',
    title: '社外参謀 1on1ブートキャンプ',
    meta: '全4回・マンツーマン',
    body: '発言や行動のベースとなる「思考OS」を、案件ベースの超実務で構築します。',
  },
  {
    step: 'STEP 2',
    title: '社外参謀 伴走プログラム',
    meta: '月2回・3〜6か月',
    body: '構築した「思考OS」を現場で実装し、目に見える成果を取りに行きます。',
  },
];

const corporateServices = [
  {
    title: 'チーム研修(基本パッケージ)',
    meta: '3名程度の少人数・全4回+伴走',
    body: 'キックオフからワークショップ、計画書づくり、遂行支援まで。自走化を前提に設計します。',
  },
  {
    title: 'プロジェクト伴走支援・コンサルティング',
    meta: '週1回 or 隔週',
    body: '「はい、わかりました」とは言いません。代行ではなく共創で、ノウハウを社内に残します。',
  },
];
---

<Base
  description="maido&crafts strategy株式会社は、個人の「思考OS」構築からチームの自走化まで、教育×実践×リフレクションで一気通貫に伴走します。個別相談は60分・3,000円・オンライン。"
  abVariants={{ hero_value_prop: heroVariant }}
>
  <!-- Hero: タイポグラフィ主体。一文で分かる提供価値をコピーの直下に置く。
       末尾の線は、ロゴのモチーフ(地平線と昇る太陽)を一筆の線として引いたもの -->
  <div class="bg-white">
    <div class="mx-auto max-w-[1120px] px-5 py-24 md:py-32 lg:px-10">
      <p class="mb-8 text-xs font-bold tracking-[0.24em] text-muted uppercase" data-reveal>
        maido &amp; crafts strategy
      </p>
      <h1 class="text-[32px] leading-[1.3] font-bold md:text-5xl" data-reveal>
        人の成長が、価値を倍増させる。
      </h1>
      <p class="mt-8 max-w-[38em] text-base leading-loose font-bold text-primary-700" data-reveal>
        {heroValueProp}
      </p>
      <p class="mt-4 max-w-[38em] text-sm leading-loose text-muted" data-reveal>
        私たちは、人が「係数」として機能することを信じています。同じ予算・設備・情報でも、成果は「人」で何倍にも変わる。だから、人の成長に投資します。
      </p>
      <div class="mt-12 flex flex-col gap-4 sm:flex-row" data-reveal>
        <Button href="/shindan/">無料の30秒診断で、伸びしろを見つける</Button>
        <Button href="/services/" variant="secondary">サービスを見る</Button>
      </div>
      <p class="mt-4 text-sm text-muted" data-reveal>
        登録は不要で、結果はその場で表示されます。じっくり話したい方は、
        <a href="/contact/" class="font-bold text-primary-700 underline underline-offset-4">個別相談(60分・3,000円)</a>
        をご利用ください。
      </p>
      <div class="mt-16 flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-5" data-reveal>
        <svg
          class="w-full max-w-[520px] text-brand-teal"
          viewBox="0 0 520 26"
          fill="none"
          aria-hidden="true"
        >
          <path d="M1 25h518" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M452 25a15 15 0 0 1 30 0Z" fill="var(--color-brand-orange)" />
        </svg>
        <span class="flex-none text-xs font-bold tracking-[0.24em] text-muted sm:pb-0.5">
          まいど、から始まる伴走
        </span>
      </div>
    </div>
  </div>

  <Section tone="subtle">
    <SectionTitle no="01">こんな悩みは、ありませんか</SectionTitle>
    <p class="mb-8 max-w-[42em] text-muted" data-reveal>
      その原因は、あなたの能力ではなく「構造」にあるのかもしれません。近いものを選んでいただくと、対応するサービスへご案内します。
    </p>

    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h3 class="mb-4 text-sm font-bold tracking-wide text-muted">
          個人の方(リーダー・マネージャー)
        </h3>
        <ul class="space-y-3" data-reveal="group">
          {personalWorries.map((worry) => (
            <li>
              <a
                href="/services/#personal"
                class="group flex items-center justify-between gap-4 rounded-lg border border-edge bg-white p-5 transition-colors duration-200 hover:border-primary-500"
              >
                <span class="font-bold text-primary-700">{worry}</span>
                <span class="flex-none text-sm font-bold text-primary-500 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 rounded-lg border border-primary-100 bg-primary-100/40 p-4 text-sm" data-reveal>
          どれが根っこなのか分からないときは、まず
          <a href="/shindan/" class="font-bold text-primary-700 underline underline-offset-4">30秒診断(無料・登録不要)</a>
          へ。チームが伸び悩む「本当のボトルネック」を確かめられます。
        </p>
      </div>
      <div>
        <h3 class="mb-4 text-sm font-bold tracking-wide text-muted">法人の方(人事・経営者)</h3>
        <ul class="space-y-3" data-reveal="group">
          {corporateWorries.map((worry) => (
            <li>
              <a
                href="/services/#corporate"
                class="group flex items-center justify-between gap-4 rounded-lg border border-edge bg-white p-5 transition-colors duration-200 hover:border-primary-500"
              >
                <span class="font-bold text-primary-700">{worry}</span>
                <span class="flex-none text-sm font-bold text-primary-500 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {/* 課題(01)のあとに到達点を置き、「可能性が広がる」を具体的に見せる */}
  <Section>
    <SectionTitle no="02">どこまでも、持ち運べる</SectionTitle>
    <p class="mb-12 max-w-[42em] text-muted" data-reveal>
      お渡しするのは、その場をしのぐ答えではありません。業種や職種が変わっても持ち運べるポータブルスキルと、そこから組み立てる「思考OS」です。だから効き目は、目の前の仕事だけで終わりません。
    </p>

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="mb-6 text-sm font-bold tracking-wide text-muted">
          個人の方(リーダー・マネージャー)
        </h3>
        <ol class="space-y-8" data-reveal="group">
          {reachPersonal.map((item, i) => (
            <li>
              <span
                class:list={[
                  'block h-1.5 rounded-full',
                  BAR_WIDTHS[i],
                  i === reachPersonal.length - 1 ? 'bg-brand-orange' : 'bg-brand-teal',
                ]}
                aria-hidden="true"
              ></span>
              <p class="mt-4 font-bold text-primary-700">{item.scope}</p>
              <p class="mt-1 text-sm text-muted">{item.body}</p>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <h3 class="mb-6 text-sm font-bold tracking-wide text-muted">法人の方(人事・経営者)</h3>
        <ol class="space-y-8" data-reveal="group">
          {reachCorporate.map((item, i) => (
            <li>
              <span
                class:list={[
                  'block h-1.5 rounded-full',
                  BAR_WIDTHS[i],
                  i === reachCorporate.length - 1 ? 'bg-brand-orange' : 'bg-brand-teal',
                ]}
                aria-hidden="true"
              ></span>
              <p class="mt-4 font-bold text-primary-700">{item.scope}</p>
              <p class="mt-1 text-sm text-muted">{item.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <p class="mt-12 text-xs text-muted" data-reveal>
      ※いずれも、プログラムを通じて目指す状態です。到達までの期間や度合いは、状況によって異なります。
    </p>
    <p class="mt-6" data-reveal>
      <a
        href="/portable-skills/"
        class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline-offset-4 hover:underline"
      >
        なぜ「持ち運べる」のか、ポータブルスキルの解説を読む →
      </a>
    </p>
  </Section>

  <Section tone="subtle">
    <SectionTitle no="03">サービス</SectionTitle>
    <p class="mb-8 max-w-[42em] text-muted" data-reveal>
      「あと一歩の壁」を超えるための伴走プログラムです。個人はステップ式、法人は自走化を前提に設計しています。
    </p>

    <h3 class="mb-4 text-sm font-bold tracking-wide text-muted">個人向け|ステップ式</h3>
    <ol class="grid gap-4 md:grid-cols-3 md:gap-6" data-reveal="group">
      {personalServices.map((service) => (
        <li class="flex flex-col rounded-lg border border-edge bg-white p-6">
          <p class="mb-2 text-xs font-bold tracking-widest text-primary-500">{service.step}</p>
          <h4 class="mb-1 text-lg font-semibold text-primary-700">{service.title}</h4>
          <p class="mb-3 text-xs font-bold text-muted">{service.meta}</p>
          <p class="flex-1 text-sm text-muted">{service.body}</p>
        </li>
      ))}
    </ol>

    <h3 class="mt-10 mb-4 text-sm font-bold tracking-wide text-muted">法人向け</h3>
    <div class="grid gap-4 md:grid-cols-2 md:gap-6" data-reveal="group">
      {corporateServices.map((service) => (
        <div class="flex flex-col rounded-lg border border-edge bg-white p-6">
          <h4 class="mb-1 text-lg font-semibold text-primary-700">{service.title}</h4>
          <p class="mb-3 text-xs font-bold text-muted">{service.meta}</p>
          <p class="flex-1 text-sm text-muted">{service.body}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center" data-reveal>
      <Button href="/services/" variant="secondary">サービスの詳細を見る</Button>
    </p>
    <p class="mt-4 text-center text-xs text-muted" data-reveal>
      プログラム料金は、内容・期間により異なるため個別にご案内しています。
    </p>
  </Section>

  <Section>
    <SectionTitle no="04">研修でも、コンサルでもなく</SectionTitle>
    <div data-reveal>
      <Positioning />
    </div>
  </Section>

  <Section tone="subtle">
    <SectionTitle no="05">私たちのやり方</SectionTitle>
    <p class="mb-8 max-w-[42em] text-muted" data-reveal>
      知識を教えて終わりにはしません。教育 × 実践 × リフレクションの循環で、「わかる」を「できる」に変えます。
    </p>
    <div data-reveal>
      <MethodSteps />
    </div>
  </Section>

  <Section>
    <SectionTitle no="06">実績と、声。</SectionTitle>
    <VoicesStats>
      <div slot="after-stats">
        <h3 class="mb-4 text-sm font-bold tracking-wide text-muted">支援実績</h3>
        <CaseList />
      </div>
    </VoicesStats>
  </Section>

  <Section tone="subtle">
    <SectionTitle no="07">安心してご相談いただける理由</SectionTitle>
    <div class="grid gap-8 lg:grid-cols-[auto_1fr] lg:gap-12">
      <div class="flex items-start gap-6" data-reveal>
        <Image
          src={tamaoka}
          alt="代表取締役 玉岡諒太の写真"
          width={320}
          height={320}
          class="h-28 w-28 flex-none rounded-full object-cover md:h-36 md:w-36"
        />
        <div>
          <p class="text-xs font-bold tracking-wide text-muted">代表取締役・創業者</p>
          <p class="mt-1 text-lg font-bold text-primary-700">玉岡 諒太</p>
          <p class="mt-3 max-w-[24em] text-sm text-muted">
            大阪の商店街で育ち、富士通・ベイカレント・ベンチャー・NECを経て独立。「作る側」と「支える側」の両方を歩いてきました。
          </p>
          <p class="mt-4">
            <a
              href="/profile/"
              class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline-offset-4 hover:underline"
            >
              プロフィールを見る →
            </a>
          </p>
        </div>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2" data-reveal="group">
        <li class="rounded-lg border border-edge bg-white p-5">
          <h3 class="mb-1 text-sm font-semibold text-primary-700">実務で磨いた支援スキル</h3>
          <p class="text-sm text-muted">
            大手SE・戦略コンサル・ベンチャー・カスタマーサクセスの現場経験にもとづく、実践的な伴走です。
          </p>
        </li>
        <li class="rounded-lg border border-edge bg-white p-5">
          <h3 class="mb-1 text-sm font-semibold text-primary-700">少人数・高密度の体制</h3>
          <p class="text-sm text-muted">
            マンツーマンまたは3名程度の少人数で、一人ひとりの現場に深く入り込みます。
          </p>
        </li>
        <li class="rounded-lg border border-edge bg-white p-5">
          <h3 class="mb-1 text-sm font-semibold text-primary-700">土台は「ポータブルスキル」</h3>
          <p class="text-sm text-muted">
            厚生労働省も定義・推進する、業種や職種が変わっても持ち運べる実践的能力を育てます。
            <a href="/portable-skills/" class="font-bold text-primary-700 underline underline-offset-4">解説を読む →</a>
          </p>
        </li>
        <li class="rounded-lg border border-edge bg-white p-5">
          <h3 class="mb-1 text-sm font-semibold text-primary-700">自走できたら、卒業</h3>
          <p class="text-sm text-muted">
            業務の代行はしません。支援が終わったあとに残るのは、報告書ではなく、自分たちで進められる人と型です。
          </p>
        </li>
      </ul>
    </div>
    <p class="mt-8 text-center" data-reveal>
      <Button href="/about/" variant="secondary">会社案内を見る</Button>
    </p>
  </Section>

  <Section>
    <SectionTitle no="08">お知らせ</SectionTitle>
    {news.length === 0 ? (
      <p class="text-muted">現在、お知らせはありません。</p>
    ) : (
      <ul class="divide-y divide-edge rounded-lg border border-edge bg-white" data-reveal>
        {news.map((item) => (
          <li>
            <a
              href={`/news/${item.id}/`}
              class="flex flex-col gap-1 px-6 py-4 transition-colors duration-200 hover:bg-paper-subtle sm:flex-row sm:items-center sm:gap-4"
            >
              <time datetime={item.data.date.toISOString().slice(0, 10)} class="text-sm text-muted">
                {formatDate(item.data.date)}
              </time>
              <span class="rounded-sm bg-paper-subtle px-2 py-0.5 text-xs font-bold text-muted">
                {item.data.category}
              </span>
              <span class="font-medium">{item.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="mt-6 text-right" data-reveal>
      <a href="/news/" class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline-offset-4 hover:underline">
        お知らせの一覧を見る
      </a>
    </p>
  </Section>

  {/* 事業の指針を、一行だけ静かに置く。詳細は会社案内へ送る */}
  <section class="bg-paper-subtle">
    <div class="mx-auto max-w-[1120px] px-5 py-20 md:py-28 lg:px-10">
      <div class="mx-auto max-w-[44em] text-center" data-reveal>
        <span class="mx-auto block h-px w-10 bg-brand-teal" aria-hidden="true"></span>
        <p class="mt-8 text-lg leading-loose font-bold text-balance md:text-2xl">
          私たちが遺したいのは、お金でも事業でもなく、人です。
        </p>
        <p class="mt-8">
          <a
            href="/about/#legacy"
            data-track="legacy_click"
            data-loc="home"
            class="inline-flex min-h-11 items-center text-sm font-bold text-primary-700 underline-offset-4 hover:underline"
          >
            「人を遺す」という指針を読む →
          </a>
        </p>
      </div>
    </div>
  </section>

  <CtaSection />
</Base>
