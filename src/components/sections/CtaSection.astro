---
import LineButton from '../ui/LineButton.astro';

// 全ページ末尾の問い合わせ誘導(既存3ページのCTAブロックを踏襲)
interface Props {
  /** 見出しをページに合わせて差し替え可能(プロフィールは「まず、聴かせてください」) */
  heading?: string;
}

const { heading = 'まず、話してみませんか' } = Astro.props;
---

<section aria-labelledby="cta-heading" class="bg-primary-900 py-16 text-white md:py-24">
  <div class="mx-auto max-w-[800px] px-5 lg:px-10">
    <p class="mb-4 inline-block rounded-full bg-white/15 px-4 py-1.5 text-xs font-bold tracking-wide">
      個別相談|60分・3,000円・オンライン
    </p>
    <h2 id="cta-heading" class="mb-4 text-2xl font-bold md:text-[28px]">{heading}</h2>
    <p class="mb-8 text-sm leading-loose opacity-95 md:text-base">
      売り込みはしません。60分の個別相談(3,000円)で、あなたの現場の「どこから手を付けるか」の見立てを、その場で必ずお渡しします。まとまっていない相談ほど、歓迎です。相談だけで終えていただいて構いません。
    </p>
    <LineButton class="mx-auto max-w-md" />
    <p class="mt-4 text-center text-xs opacity-85">
      合わないと感じたら、そこで終わりにして大丈夫です。
    </p>
    <p class="mt-6 text-center text-sm">
      <a href="/contact/" class="underline underline-offset-4 hover:opacity-80">
        法人研修・料金のご相談はこちら
      </a>
    </p>
  </div>
</section>
