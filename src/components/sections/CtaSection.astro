---
import LineButton from '../ui/LineButton.astro';

// 全ページ末尾の問い合わせ誘導。相談内容を具体化した2つの導線に分ける
// (個人=LINEが最短 / 法人・料金=フォーム)。文言は既存3ページのCTAブロックを踏襲
interface Props {
  /** 見出しをページに合わせて差し替え可能(プロフィールは「まず、聴かせてください」) */
  heading?: string;
}

const { heading = 'まず、話してみませんか' } = Astro.props;
---

<section aria-labelledby="cta-heading" class="bg-primary-900 py-16 text-white md:py-32">
  <div class="mx-auto max-w-[1120px] px-5 lg:px-10">
    <div class="mx-auto max-w-[800px] text-center" data-reveal>
      <p class="mb-4 flex items-center justify-center gap-4 text-xs font-bold tracking-[0.24em] text-primary-100/80" aria-hidden="true">
        <span class="h-px w-10 bg-brand-teal"></span>
        ご相談・お問い合わせ
        <span class="h-px w-10 bg-brand-teal"></span>
      </p>
      <h2 id="cta-heading" class="text-2xl font-bold md:text-[28px]">{heading}</h2>
      <p class="mt-5 text-sm leading-loose opacity-95 md:text-base">
        売り込みはしません。まとまっていない相談ほど、歓迎です。
      </p>
      <p class="mt-3 text-sm leading-loose opacity-95 md:text-base">
        合わないと感じたら、そこで終わりにして大丈夫です。
      </p>
      <p class="mt-6 text-sm leading-loose font-bold text-balance md:text-base">
        私たちのゴールは、支援が要らなくなることです。だから、続けていただくための提案はしません。
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-[880px] gap-4 md:grid-cols-2 md:gap-6" data-reveal="group">
      <div class="flex flex-col rounded-lg border border-white/20 bg-white/5 p-6 md:p-8">
        <p class="mb-3 inline-block self-start rounded-full bg-white/15 px-3 py-1 text-xs font-bold tracking-wide">
          個人の方|60分・3,000円・オンライン
        </p>
        <h3 class="mb-2 text-lg font-bold">まずは、現状のモヤモヤを話してみる</h3>
        <p class="mb-6 flex-1 text-sm opacity-90">
          60分の個別相談で、あなたの現場の「どこから手を付けるか」の見立てを、その場で必ずお渡しします。相談だけで終えていただいて構いません。
        </p>
        <LineButton loc="cta_section" />
        <p class="mt-3 text-center text-xs opacity-85">
          その前に、
          <a href="/shindan/" class="font-bold underline underline-offset-4">無料の30秒診断</a>
          で現状を確かめることもできます。
        </p>
      </div>

      <div class="flex flex-col rounded-lg border border-white/20 bg-white/5 p-6 md:p-8">
        <p class="mb-3 inline-block self-start rounded-full bg-white/15 px-3 py-1 text-xs font-bold tracking-wide">
          法人の方|チーム研修・伴走支援
        </p>
        <h3 class="mb-2 text-lg font-bold">チーム研修・料金について問い合わせる</h3>
        <p class="mb-6 flex-1 text-sm opacity-90">
          料金・お見積りは、状況を伺ったうえで個別にご案内します。検討段階のご相談も歓迎です。3営業日以内にご返信します。
        </p>
        <a
          href="/contact/#form-heading"
          data-track="cta_contact_click"
          data-loc="cta_section"
          class="block rounded-full bg-white px-6 py-4 text-center font-bold text-primary-700 transition-opacity duration-200 hover:opacity-90"
        >
          フォームで問い合わせる
          <span class="mt-0.5 block text-xs font-bold text-muted">入力は6項目・3分ほどで完了します</span>
        </a>
      </div>
    </div>
  </div>
</section>
