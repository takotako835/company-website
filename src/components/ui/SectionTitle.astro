---
// 既存3ページの「オレンジマーカー付き見出し」を継承(注目点にのみオレンジを使用)。
// no を渡すと、通し番号+ティールの罫線(補助色の規定用途)を見出し上に添える
interface Props {
  id?: string;
  class?: string;
  /** セクション通し番号(例: "01")。トップページの章立てに使う */
  no?: string;
}

const { id, class: className, no } = Astro.props;
---

{
  no && (
    <p class="mb-4 flex items-center gap-4 text-xs font-bold tracking-[0.24em] text-muted" aria-hidden="true">
      <span class="tabular-nums">{no}</span>
      <span class="h-px w-12 bg-brand-teal"></span>
    </p>
  )
}
<h2
  id={id}
  class:list={[
    'mb-6 flex items-center gap-3 text-2xl font-bold md:mb-8 md:text-[28px]',
    className,
  ]}
>
  <span class="h-6 w-1.5 flex-none rounded-sm bg-brand-orange" aria-hidden="true"></span>
  <slot />
</h2>
