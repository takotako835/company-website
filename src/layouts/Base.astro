---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import { SITE } from '../lib/site';
import symbolOrange from '../assets/maido_symbol_orange.png';

interface Props {
  /** ページ固有タイトル。トップは空にして社名先頭の形にする */
  title?: string;
  description: string;
  /** ページごとに固有のJSON-LDを追加したい場合に渡す */
  jsonLd?: Record<string, unknown>[];
  /** 送信完了ページなど、検索結果に出す必要がないページで true にする */
  noindex?: boolean;
  /** A/Bテストの配信中バリアント。計測ビーコンが body の data 属性から拾う */
  abVariants?: Record<string, string>;
}

const { title, description, jsonLd = [], noindex = false, abVariants = {} } = Astro.props;

const abDataAttrs = Object.fromEntries(
  Object.entries(abVariants).map(([key, value]) => [`data-ab-${key.replaceAll('_', '-')}`, value]),
);

const fullTitle = title
  ? `${title}｜${SITE.companyName}`
  : `${SITE.companyName}｜人の成長が価値を倍増させる`;

const canonical = new URL(Astro.url.pathname, Astro.site);
// TODO: OGP画像はロゴを白背景に置いた仮版(public/ogp.png)。デザイン版ができたら差し替える
const ogImage = new URL('/ogp.png', Astro.site);

// 全ページ共通の Organization 構造化データ(06_seo-performance §2)
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.companyName,
  url: Astro.site?.toString(),
  logo: new URL(symbolOrange.src, Astro.site).toString(),
  foundingDate: SITE.foundingDate,
  founder: { '@type': 'Person', name: SITE.representative },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
    addressRegion: '東京都',
    streetAddress: SITE.address.replace('東京都', ''),
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: new URL(SITE.contactPath, Astro.site).toString(),
    availableLanguage: ['Japanese'],
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1F3A5F" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.companyName} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationLd)}
    />
    {jsonLd.map((ld) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="pb-20 md:pb-0" {...abDataAttrs}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:bg-white focus:px-4 focus:py-2 focus:text-primary-700"
    >
      本文へスキップ
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <script>
      // ===== アクセス計測ビーコン(自前・Cookieなし) =====
      // 送信先 /api/track は Supabase 未設定のあいだ何もしない。
      // 個人情報は送らない。docs/08_analytics-improvement.md 参照
      const isAdmin = location.pathname.startsWith('/admin');
      const params = new URLSearchParams(location.search);
      const base = {
        path: location.pathname,
        referrer: document.referrer || null,
        utm_source: params.get('utm_source'),
        utm_medium: params.get('utm_medium'),
        utm_campaign: params.get('utm_campaign'),
      };
      const abMeta: Record<string, string> = {};
      for (const [key, value] of Object.entries(document.body.dataset)) {
        if (key.startsWith('ab') && value) abMeta[key] = value;
      }
      function track(type: string, meta: Record<string, unknown> = {}): void {
        if (isAdmin) return; // 管理画面の閲覧は計測に混ぜない
        try {
          const payload = JSON.stringify({ type, ...base, meta: { ...abMeta, ...meta } });
          navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
        } catch {
          // 計測の失敗で表示を止めない
        }
      }
      (window as unknown as { __track?: typeof track }).__track = track;

      track('pageview');

      // クリック計測: data-track 属性を持つ要素(LINEボタン等)
      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest?.('[data-track]');
        if (el instanceof HTMLElement && el.dataset.track) {
          track(el.dataset.track, { loc: el.dataset.loc ?? '' });
        }
      });

      // スクロール到達(50% / 90%・各1回)
      const sent = new Set<number>();
      addEventListener(
        'scroll',
        () => {
          const doc = document.documentElement;
          const depth = ((scrollY + innerHeight) / doc.scrollHeight) * 100;
          for (const mark of [50, 90]) {
            if (depth >= mark && !sent.has(mark)) {
              sent.add(mark);
              track('scroll_depth', { depth: mark });
            }
          }
        },
        { passive: true },
      );

      // 表示速度の実測(LCP / CLS / INP)。ページを離れるときに1回だけ送る
      let lcp = 0;
      let cls = 0;
      let inp = 0;
      try {
        new PerformanceObserver((list) => {
          const last = list.getEntries().at(-1);
          if (last) lcp = Math.round(last.startTime);
        }).observe({ type: 'largest-contentful-paint', buffered: true });
        new PerformanceObserver((list) => {
          for (const entry of list.getEntries() as PerformanceEntry[]) {
            const shift = entry as unknown as { hadRecentInput: boolean; value: number };
            if (!shift.hadRecentInput) cls += shift.value;
          }
        }).observe({ type: 'layout-shift', buffered: true });
        new PerformanceObserver((list) => {
          for (const entry of list.getEntries()) {
            inp = Math.max(inp, Math.round(entry.duration));
          }
        }).observe({ type: 'event', buffered: true, durationThreshold: 40 } as PerformanceObserverInit);
      } catch {
        // 未対応ブラウザでは速度計測だけ諦める
      }
      let vitalsSent = false;
      addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden' && !vitalsSent && lcp > 0) {
          vitalsSent = true;
          track('vitals', { lcp, cls: Math.round(cls * 1000) / 1000, inp });
        }
      });
    </script>
    <script>
      // data-reveal 要素が画面に入ったら .is-visible を付ける(CSS側で演出)
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');
      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
