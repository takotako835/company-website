# このファイルをコピーして `.env` を作ると、開発サーバーで使われます
# (`.env` は Git にコミットされません)

# サイトの公開URL。canonical / OGP / sitemap / robots.txt に反映される
# 本番では Render の環境変数で設定するため、通常ここは設定不要
SITE_URL=http://localhost:4321

# お問い合わせフォームの送信先URL(外部フォームサービス)
# 未設定の場合、フォームは表示されずLINE導線の案内に切り替わる
# 取得手順は docs/07_deploy-render.md の「お問い合わせフォームの設定」を参照
PUBLIC_FORM_ENDPOINT=
