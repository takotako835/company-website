# このファイルをコピーして `.env` を作ると、開発サーバーで使われます
# (`.env` は Git にコミットされません)
#
# ★このファイルには本物の値を書かないでください。
#   本物は Render の「Environment」に入れます。
#   取得手順は docs/07_deploy-render.md を参照してください。

# サイトの公開URL。canonical / OGP / sitemap / robots.txt に反映される
# 本番では Render の環境変数で設定するため、通常ここは設定不要
SITE_URL=http://localhost:4321

# ── メールの送信(Resend)───────────────────────
# お問い合わせフォームは、この3つがすべて揃っているときだけ表示されます。
# 未設定の場合はフォームを出さず、LINE導線の案内に切り替わります。

# ★Resend の API キー。秘密の値です。人に見せないでください
RESEND_API_KEY=

# 差出人。ドメインは Resend で認証したものにします
# 例: maido&crafts strategy <no-reply@ywc-maido.com>
MAIL_FROM=

# お問い合わせの届け先(社内の受信アドレス)
# ★サイトには表示されません。フォーム送信の宛先としてのみ使われます
CONTACT_TO=
